    function ChangePasswordToast(title, msg) {
        Swal.fire({
            title: title,
            //html: "<h3>Password Successfully Changed</h3><br/>" + msg,
            icon: "success",
            showCancelButton: false,
            confirmButtonText: "Log out",
            reverseButtons: true,
            allowOutsideClick: false,
            allowEscapeKey: false
        }).then((result) => {
            if (result.isConfirmed) {
                // Redirect to logout
                window.location.href = "/UserAccount/Login";
                // If your route is different, adjust the URL accordingly.
            }
        });
    }


</script>

@if(TempData["UserMsg"] != null)
{        
    <script>
        document.addEventListener("DOMContentLoaded", function() {
                ChangePasswordToast("@TempData["UserMsg"]", "Change Password");
       });
    </script>
}


                    
