@model UserAdminViewModel

@{
    ViewData["Title"] = "Edit User";
    Layout = "_Layout";
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.min.css">
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-6 col-md-8">

            <!-- Page Title -->
            <div class="text-center mb-4">
                <h1 class="fw-bold">Edit User</h1>
                <p class="text-muted">Update/Reset user password</p>
                <hr />
            </div>

            <div class="card shadow-sm">
                <div class="card-body p-4">

                    @* Validation Summary *@
                    <div asp-validation-summary="All" class="text-danger mb-3"></div>

                    <form asp-action="Edit" method="post">

                        <input asp-for="@Model.User.Id" type="hidden" />

                        <!-- Email -->
                        <div class="mb-3 text-start">
                            <label asp-for="@Model.User.Email" class="form-label fw-semibold">Email Address</label>
                            <input asp-for="@Model.User.Email" class="form-control" placeholder="Enter email" />
                            <span asp-validation-for="@Model.User.Email" class="text-danger"></span>
                        </div>

                        <!-- Password -->
                        <div class="mb-3 text-start">
                            <label for="password" class="form-label fw-semibold">New Password</label>
                            <input name="password" class="form-control" type="password"
                                   placeholder="New Password" />
                        </div>

                        <!-- Buttons -->
                        <div class="text-center mt-4">
                            <button type="submit" class="btn btn-primary btn-sm px-2 me-2">
                                <i class="fa fa-save me-1"></i> Update Password
                            </button>

                            <a href="~/UserAdmin/Index" class="btn btn-secondary btn-sm p2-4 me-2" >
                                Cancel
                            </a>
                        </div>

                    </form>

                </div>
            </div>

        </div>
    </div>
</div>


