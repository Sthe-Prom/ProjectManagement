                                                                      <small class="text-muted">or click to browse</small>
                                                                  </div>

                                                                  <input type="file" class="form-control mt-2 d-none"
                                                                        asp-for="@Model.ProjectFiles" required />
                                                              </div>
                                                              

                                                              @* ActivityModel_MemberProject *@
