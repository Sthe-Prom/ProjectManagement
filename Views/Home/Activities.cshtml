                                          closeOnConfirm: false,
                                          html: true
                                      },
                                        function(){
                                              location.reload();
                                          });


                              } else {
                                  swal("Cancelled", "No Activities Deleted:)", "error");
                              }
                          });

              });

          };

    </script>

