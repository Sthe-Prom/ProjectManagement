                                                            </div>
                                                            
                                                          </div>

                                                          @* <div class="mb-3 form-group">
                                                              <label asp-for="@Model.ActivityModel.ActivityProgress" class="col-form-label fw-bold">Activity Progress (%)</label>
                                                              <input type="range" min="0" max="100" asp-for="@Model.ActivityModel.ActivityProgress" class="form-range"  />
