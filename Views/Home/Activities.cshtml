                                    <tr class="">
                                        
                                        <th rowspan="1" class="header text-center align-middle text-align:center" style="width:20%">Activity Name</th>
                                        <th rowspan="1" class="header text-center align-middle text-align:center" style="width:25%">Comments</th>
                                        <th rowspan="1" class="header text-center align-middle text-align:center" style="width:15%">Challenges</th>
                                        <th rowspan="1" class="header text-center align-middle text-align:center" style="width:10%">Start-End Date</th>
                                        <th rowspan="1" class="header text-center align-middle text-align:center" style="width:10%">Duration</th>
                                        <th colspan="1" class="header text-center align-middle text-align:center" style="width:10%">Progress</th>
                                        <th rowspan="1" class="header text-center align-middle text-align:center" style="width:5%">Files</th>
                                        <th rowspan="1" style="color:#dc3545 !important;" class="header text-danger text-center align-middle" style="width:15%">Action</th>
                                    </tr>

                                </thead>                       

                                    <tbody >
                                    @{       

                                        @* Activity Section *@
                                        var countActivity = 0;
                                        foreach(var act in activities_data
                                                .Where(a => a.ProjectID == ViewBag.Project)
                                                .OrderBy(a => a.ActivityStartDate))
                                        {
                                            countActivity++;
                                            @* ACTIVITIES *@
                                            <tr>

                                            @{
                                                var act_style = "";

                                                @* // Activity Style
                                                if(proj.AccountID == currentUser.AccountID && proj.Id != act.MemberProject) //Project Owner Actions
                                                {
                                                    act_style = "border-left:2px solid lightgrey;";
                                                }
                                                else 
                                                if(proj.AccountID != currentUser.AccountID && proj.Id == act.MemberProject) //Project Owner Actions
                                                {
                                                    act_style = "border-left:2px solid lightgrey;";
                                                }
                                                else
                                                {
                                                    act_style = "border-left:2px solid #c59217;";
                                                }                                             *@
                                            }

                                                @* ActivityName *@
                                                <td style="width:20%" class="align-middle" style="@act_style">
                                                    <span>
                                                    <span class="fw-bold">@countActivity.</span> @act.ActivityName
                                                    </span>
                                                </td>

                                                @* ActivityComments *@
                                                <td style="width:25%" class="align-middle">
                                                    @act.ActivityComments
                                                </td>

                                                @* Challenges *@
                                                <td style="width:10%" class="align-middle">
                                                    @act.ActivityChallenges
                                                </td>

                                                @* Activity Start Date *@
                                                <td style="width:15%" class="align-middle text-center align-center">
                                                  <span>
                                                    @act.ActivityStartDate.ToString("dd MMM yy")
                                                    <i class="bi bi-arrow-right-short"></i>
                                                    @act.ActivityEndDate.ToString("dd MMM yy")
                                                  </span>
                                                </td>

                                                @* Activity Durarion *@
                                                <td style="width:10%" class="align-middle text-center">
                                                  @*<small class="text-muted" >
                                                    <span style="font-size:11px;"> Days </span></small><span class="badge bg-light fs-7" style="color:#0F204B;">@totalDays</span> | <small class="text-muted"><span class="badge bg-light fs-7" style="color:#0F204B;">@totalWeeks</span><span style="font-size:11px;"> Weeks </span></small> *@

                                                    @{
                                                      var getTTCompletion_useract = act.ActivityEndDate - act.ActivityStartDate;

                                                      // Option A: Using TimeSpan properties (most common and readable)
                                                      int totalDays_useract = getTTCompletion_useract.Days;
                                                      int totalWeeks_useract = getTTCompletion_useract.Days / 7;
                                                      var duration_style = "";
                                                      var title_tag = "";
                                                                            
                                                    }

                                                    @if(due_soon.Any(x => x.Id == act.Id))
                                                    {
                                                      duration_style = "text-warning";
                                                      title_tag = "data-bs-toggle=\"tooltip\" data-bs-placement=\"top\" title=\"This activity is due soon.\"";
                                                    }

                                                    @if(overdue.Any(x => x.Id == act.Id))
                                                    {
                                                      duration_style = "text-danger";
                                                      title_tag = "data-bs-toggle=\"tooltip\" data-bs-placement=\"top\" title=\"This activity is overdue.\"";
                                                    }

                                                    @if(totalDays_useract <= 0)
                                                        {
                                                        <span class="ps-3 justify-content-between" style="display: inline-flex; align-items: center;width:80px;">
                                                            <i class="bi bi-clock-history fs-6 @duration_style" @Html.Raw(title_tag)></i>
                                                            <span style="margin-left: 0.30rem;font-weight:100">1 Day</span>
                                                        </span>
                                                        }else
                                                            if(totalDays_useract > 0 && totalDays_useract <= 7)
                                                            {
                                                            <span class="ps-3 justify-content-between" style="display: inline-flex; align-items: center;width:80px;">
                                                             
                                                                <i class="bi bi-clock-history fs-6 @duration_style" @Html.Raw(title_tag)></i>
                                                           
                                                                <span style="margin-left: 0.30rem;font-weight:100">@totalDays_useract Days</span>
                                                            </span>
                                                            }else
                                                                if(totalDays_useract > 7 && totalWeeks_useract <= 5 )
                                                                {

                                                                <span class="ps-3 justify-content-between" style="display: inline-flex; align-items: center;width:80px;">
                                                                    <i class="bi bi-clock-history fs-6 @duration_style" @Html.Raw(title_tag)></i>
                                                                    <span style="margin-left: 0.30rem;font-weight:100">@totalWeeks_useract Wks</span>
                                                                </span>

                                                                }
                                                                else
                                                                if(totalWeeks_useract > 5 )
                                                                {
                                                                    int months = 0;
                                                                    DateTime endDate = act.ActivityEndDate;
                                                                    DateTime startDate = act.ActivityStartDate;
                                                                    while(startDate < endDate)
                                                                    {
                                                                        DateTime checkDate = startDate.AddMonths(1);
                                                                        if(checkDate <= endDate)
                                                                        {
                                                                            months++;
                                                                            startDate = checkDate;
                                                                        }
                                                                        else
                                                                        {
                                                                            break;
                                                                        }
                                                                    }
                                                                    <span class="ps-3 justify-content-between" style="display: inline-flex; align-items: center;width:80px;">
                                                                        <i class="bi bi-clock-history fs-6 @duration_style" @Html.Raw(title_tag)></i>
                                                                        <span style="margin-left: 0.30rem;font-weight:100">@months Mnts</span>
                                                                    </span>
                                                                }

                                                </td>

                                                @* Activity Status *@
                                                <td style="width:10%" class="align-middle text-center">
                                                    @if(act.ActivityProgress == 2)
                                                    {
                                                        <span class="badge rounded-pill bg-primary">Started</span>
                                                    }
                                                    else
                                                    @if(act.ActivityProgress == 1)
                                                    {
                                                        <span class="badge rounded-pill bg-light text-muted">Upcoming</span>
                                                    }
                                                    else
                                                    @if(act.ActivityProgress == 3)
                                                    {
                                                        <span class="badge rounded-pill bg-info">Ongoing</span>
                                                    }
                                                    else
                                                    @if(act.ActivityProgress == 4)
                                                    {
                                                        <span class="badge rounded-pill bg-success">Completed</span>
                                                    }
                                                    else
                                                    @if(act.ActivityProgress == 5)
                                                    {
                                                        <span class="badge rounded-pill bg-danger">Incomplete</span>
                                                    }
                                                    else
                                                    @if(act.ActivityProgress == 6)
                                                    {
                                                        <span class="badge rounded-pill bg-secondary text-muted">On-Hold</span>
                                                    }
                                                    else
                                                    @if(act.ActivityProgress == 7)
                                                    {
                                                        <span class="badge rounded-pill bg-warning">Sent for Review</span>
                                                    }

                                                </td>
                                             
                                                @* Attachments *@
                                                <td style="width:5%" class="text-center align-middle">
                                                    <ul class="list-unstyled d-flex mb-4" style="margin: 0 !important; padding: 0 !important;">

                                                        @* Attachments *@
                                                        @if(!String.IsNullOrEmpty(act.ProjectFiles) && act.ProjectFiles.Contains('.'))
                                                        {
                                                        <li class="">
                                                            @{
                                                                string fileName = act.ProjectFiles.Length >= 3 ? act.ProjectFiles.Substring(4) : act.ProjectFiles;
                                                             }
                                                            <a href="~/Attachments/Activity/@act.ProjectFiles" data-bs-toggle="tooltip" data-bs-placement="top" title="@fileName" class="clip" download>
                                                                <i class="bi bi-paperclip fs-5"></i>
                                                            </a>
                                                        </li>
                                                        }
                                                        else
                                                        {
                                                        <li class="" data-bs-toggle="tooltip" data-bs-placement="top" title="No attachments for this project.">
                                                            <a class="" aria-disabled="true" disabled>
                                                                <i class="bi bi-paperclip fs-5"></i>
                                                            </a>
                                                        </li>
                                                        }


                                                    </ul>
                                                </td>

                                                @* Actions *@
                                                <td style="width:15%" class="text-center align-middle">
                                                @{
                                                    //var act2 = Model.Activities.Where(c => c.ProjectID == act.ProjectID).FirstOrDefault();
                                                    //var proj2 = Model.Projects.Where(c => c.Id == act2.ProjectID & c.AccountID != currentUser.AccountID).FirstOrDefault();
                                                    //var b = new List<int>{8,9,10};

                                                    if(act.AccountID == currentUser.AccountID && act.Id != act.MemberProject) //Project Owner Actions
                                                    {
                                                        <ul class="list-unstyled d-flex" style="margin: 0 !important; padding: 0 !important;">

                                                            @* EDIT *@
                                                            <li class="align-middle" data-bs-toggle="modal" data-bs-target="#btnEditActivity_@act.Id" >
                                                            <span class="safe">
                                                                <i class="bi bi-pencil-square"></i>
                                                            </span>
                                                            </li>

                                                            @* DELETE *@
                                                            <li id="btnDeleteActivity_@act.Id">
                                                            <span class="danger">
                                                                <i class="bi bi-trash3"></i>
                                                            </span>
                                                            </li>

                                                        </ul>
                                                    }
                                                    else
                                                    if(act.AccountID != currentUser.AccountID && act.Id == act.MemberProject) //Member Actions
                                                    {
                                                        <ul class="list-unstyled d-flex" style="margin: 0 !important; padding: 0 !important;">

                                                        @* EDIT *@
                                                        <li class="align-middle" data-bs-toggle="modal" data-bs-target="#btnEditActivity_@act.Id" >
                                                            <span class="safe">
                                                                <i class="bi bi-pencil-square"></i>
                                                            </span>
                                                        </li>

                                                        @* DELETE *@
                                                        <li id="btnDeleteActivity_@act.Id">
                                                            <span class="danger">
                                                                <i class="bi bi-trash3"></i>
                                                            </span>
                                                        </li>


                                                        </ul>
                                                    }

                                                  }

                                                </td>

                                            </tr>

                                            @* Update Activity *@                                        
                                            <div class="modal modal-md fade" id="btnEditActivity_@act.Id" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1" aria-labelledby="staticBackdropLabel1" aria-hidden="true">
                                                <div class="modal-dialog modal-xl">
                                                  <form class="act_form" enctype="multipart/form-data" id="act_form_@act.Id" >

                                                        <div class="modal-content">
                                                          <div class="modal-header d-flex flex-row justify-content-between">
