                                  </span>
                              </div>
                              <div class="flex-grow-1 bc-white p-3 text-center">
                                  <div class="sub pb-2 fw-bold">Overdue</div>
                                  <span style="border-radius:50%; background-color:rgba(220, 53, 69, 0.3); padding: 10px 15px; display: inline-block;">
                                      <i style="color:#dc3545;font-size:24px;" class="bi bi-exclamation-triangle text-danger"></i>                                      
                                  </span>
                                  <span class="ms-3 fw-bold fs-3">
                                    @overdue.Count
                                  </span>
                              </div>
                              @* <li class="col-auto list-inline-item rounded-2 p-2 text-center" style="border:1px solid lightgrey">    *@
                              <div class="flex-grow-1 bc-white p-3 text-center">
                                  <div class="sub pb-2 fw-bold">Due in 7 Days</div>
                                  <span style="border-radius:50%; background-color:rgba(255, 193, 7, 0.3); padding: 10px 15px; display: inline-block;">
                                      <i style="font-size:24px;" class="bi bi-clock text-warning"></i>                                      
                                  </span>
                                  <span class="ms-3 fw-bold fs-3">
                                    @due_soon.Count
                                  </span>
                              </div>
                          </div>

                            @* Highlights *@
                          <div class="d-flex flex-row justify-content-center gap-2 mt-2 mb-0">

                              @* <!-- Challenges & Comments Highlights --> *@                              
                              <div class="card shadow-sm col-sm-8 bc-white mb-0 pb-0">
                                <div class="card-header d-flex justify-content-between align-items-center">
                                  <span>Highlights: Comments & Challenges</span>
                                  <span class="small-muted">Top keywords</span>
                                </div>
                                <div class="card-body d-flex " style="height:100px;">
                                  
                                  @{var highlight = "";var highlight_style = "";}
