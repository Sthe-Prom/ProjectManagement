                                                                  <select class="form-select mb-3" asp-for="@Model.ActivityModel.ActivityProgress" asp-items="Model.ActivityStatuses" required>
                                                                      <option value="" selected>Select Activity Status: </option>
                                                                  </select>

                                                              </div>

                                                              @* Dates *@
                                                              <div class="col-sm-12 mb-1 d-flex justify-content-center">
