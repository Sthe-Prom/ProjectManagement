                                    {
                                      highlight += "<span class=\"text-success\"> " + item.ActivityHighlights + "</span>";
                                    }
                                    else
                                    {
                                      highlight += "<i class=\"bi bi-dot\"></i>";
                                    }//End

                                    if(item.ActivityChallenges != null )
                                    {
                                      highlight += "<span class=\"text-danger\"><i class=\"bi bi-dot\"></i> " + item.ActivityChallenges + "</span>";
                                    }
                                    else
                                    {
                                      highlight += "<i class=\"bi bi-dot\"></i>";
                                    }//End                                                                         
                                    
                                  }

                                  <ul id="recentNotes" class="list-group-flush overflow-auto pt-1 ps-0 pb-0 mb-1 w-100" style="border-bottom:2px solid lightgray;">
                              
                                       <li class="small-muted text-left list-group-item justify-content-left" style="list-style-type: disc;">                                        
                                          @Html.Raw(highlight)                                                                     
                                      </li>

                                  </ul>
                                  
                                  
                                </div>
                              </div>
                              
                              @* <!-- Recent Updates --> *@                              
                              <div class="card shadow-sm col-sm-4 bc-white mb-0 pb-0 ">
                                <div class="card-header d-flex justify-content-between align-items-center">
                                  <span>Recent updates</span>
                                  <span class="small-muted"></span>
                                </div>
                                <div class="card-body d-flex" style="height:100px;">
                                  <ul id="recentUpdates" class="list-group list-group-flush overflow-auto pt-1 mb-1 w-100" style="border-bottom:2px solid lightgray;" >
                                      @foreach(var item in updates)
