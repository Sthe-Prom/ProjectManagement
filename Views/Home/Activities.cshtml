                  formData_act.append("act_ActivityHighlights", formData_act.get('act.ActivityHighlights') );
                  formData_act.append("act_ActivityStartDate", formData_act.get('act.ActivityStartDate') );
                  formData_act.append("act_ActivityEndDate", formData_act.get('act.ActivityEndDate') );
                  formData_act.append("act_ActivityProgress", formData_act.get('act.ActivityProgress') );
                  formData_act.append("ActivityModel_Id", formData_act.get('ActivityModel.Id') );
                  
                  if (file_input.files.length > 0) {
                    formData_act.append('ProjectFiles', file_input.files[0]); // name must match server binding
                  }

                  // formData_act.append("ProjectFiles",  values[10][1] );

                  var f = [];                        
                  var s = '<div style="text-align: center !important;">Please correct the following errors:</div>' + "<hr><br />";

                  //Activity Date
                  var dateStart = formData_act.get('act.ActivityStartDate');
                  var dateEnd = formData_act.get('act.ActivityEndDate');

                  //Project Date
                  var proj_id = formData_act.get('act.ProjectID');
                  var n = document.getElementById('frmEditProject_'+proj_id);
                  var formData_temp = new FormData(n);
                  const values_ = [...formData_temp.entries()];
                  
                  var dateStart_proj = formData_temp.get('proj.ProjectStartDate');
                  var dateEnd_proj = formData_temp.get('proj.ProjectEndDate');
                    
                  if(dateEnd < dateStart){
                    s += "Activity End Date cannot be earlier than the Activity Start Date." + '<br />';
                    f.push('1');
                  }                  

                  if(dateStart < dateStart_proj){
                    s += "Activity Start Date cannot be earlier than the Project Start Date." + '<br />';
                    f.push('2');
                  } 

                  if(dateEnd > dateEnd_proj){
                    s += "Activity End Date cannot be after the Project End Date." + '<br />';
                    f.push('3');
                  }  

                  for(i = 0; i < values.length;i++){
                    if(values[i][1] === 0)// || values[i][1].name == "")
                    {
                      if(values[i][0].includes('.')){
                          if(values[i][0] !== "ActivityModel.ActivityComments" && 
                            values[i][0] !== "ActivityModel.ActivityChallenges" && 
                            values[i][0] !== "ActivityModel.ActivityHighlights" &&
                            values[i][0] !== "ActivityModel.MemberProject"){
                            s += values[i][0].split('.')[1] + ' is required <br />';
                            f.push(values[i][1]);
                          }
                        }else{
                          s += values[i][0] + ' is required <br />';
                          f.push(values[i][1]);
                        }

                    }
                  }

                  if(f.length > 0){
                      //validateAddRoadFactorsForm();
                      //alert(s);
                      ActivityAddError('',s);
                      //validatedNew();
                  }
                  else{

                      $.ajax({
                          type: 'POST',
                          url: '@Url.Action("UpdateActivity", "Home")' + '/'+ num_extr[0],
                          contentType: false,
                          processData: false,
                          cache: false,
                          data: formData_act,
                          success: activityUpdateSuccess,
                          error: activityUpdateError
                      });
                  }

                    function activityUpdateError(response){
                      if(response.responseCode == 1){
                        alert("An error occured while updating your Activity. please try again." + '\n' + response.responseMessage)
                      }
                    }

                    function activityUpdateSuccess(response) {
                        if (response.responseCode == 0) {

                            ActivityUpdate("Update Activity", "Activity Name: " + response.responseMessage
                                + " was updated successfully.");
                            //alert("Activity Added Successfully.");
                        }
                        else {
                            alert(response.responseMessage);
                        }
                    }


              });          
            

              //DELETE Activity
              $("#btnDeleteActivity_"+num_extr[0]).on("click", function() {

                      swal({
                          title: "Are you sure?",
                          text: "Activities deleted cannot be recovered",
                          type: "warning",
                          showCancelButton: true,
                          confirmButtonColor: "#DD6B55",
                          confirmButtonText: "Yes, delete Activity!",
                          cancelButtonText: "No, cancel!",
                          closeOnConfirm: false,
                          closeOnCancel: false
                          },
                          function (isConfirm) {
                              if (isConfirm) {
                                      $.ajax({
