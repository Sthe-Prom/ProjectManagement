                                                                    <label class="col-form-label fw-bold">Start Date: <span class="text-danger">*</span></label>
                                                                    <input type="date" asp-for="@Model.ActivityModel.ActivityStartDate" class="form-control"  />
                                                                </div>

                                                                <div class="flex-grow-1">
