                    @* DASH 2 *@
                    <div class="row g-3 p-2 " style="background-color: none !important;" >
                      
                        @{
                            //double kpiActual = ((double)kpiDigi / (double)kpiTotal)*100;
                            var overall_completed  = 0;
                            var act_total = 0;
                            double act_avg = 0;
                            var in_progress_list = new[] {1,4,5,7,6};
                            //var in_progress = new List<ProjectManagement.Models.Activity>();
                            var in_progress = activities_data.Where(x => false).ToList();
                            var overdue = activities_data.Where(x => false).ToList();
                            var due_soon = activities_data.Where(x => false).ToList();
                            var highlights = activities_data.Where(x => false).ToList();
                            var updates = activities_data.Where(x => false).ToList();

                            var project_ = Model.Projects.FirstOrDefault(x => x.Id == ViewBag.Project);
                            
                            if(project_?.Activities?.Any() == true)
                            {
                                overall_completed = activities_data.Where(x => x.ActivityProgress == 4).ToList().Count();
                                act_total = activities_data.ToList().Count();                                  
                                act_avg = ((double)overall_completed / act_total)*100;
                                
                                in_progress = activities_data.Where(x => !in_progress_list.Contains(x.ActivityProgress)).ToList();
                                var today = DateTime.UtcNow.Date;
                                var seven_days = DateTime.UtcNow.AddDays(7);
                                overdue = activities_data.Where(x => x.ActivityProgress != 4 && x.ActivityProgress != 5 && x.ActivityEndDate < today).ToList(); //Activity not completed and past dueDate
                                due_soon = activities_data.Where(x => x.ActivityProgress != 4 && x.ActivityEndDate > today && x.ActivityEndDate < seven_days).ToList();
                                highlights = activities_data.OrderBy(x => x.ActivityUpdateTime)
                                                            .Take(3).ToList();
                                updates = activities_data.OrderBy(x => x.ActivityUpdateTime).Take(10).ToList();

                            }
                            
                        }

                        <div class="col-sm-12 col-md-12 col-lg-10 mx-auto">
                         
