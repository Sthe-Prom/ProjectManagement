                                                      </div>

                                                    </div>
                                                  </div>

                                              </form>
                                          </div>
                                        </div>                                                                                       

                                    }

                                    </tbody>

                            </table>
                    
                        </div>

                    </div>

                </div>
            }
    }
}

<script>

    window.addEventListener('DOMContentLoaded', function () {

        //Search button style
        var searchString = document.getElementById("searchString");

        if (searchString) {
          searchString.classList.add('form-control','w-25','col','border-primary');
          searchString.setAttribute("placeholder", "Search projects...");
        }
        
        const params = new URLSearchParams(window.location.search);

        const rawStartDate = params.get("StartDate");
        const rawEndDate = params.get("EndDate");

        function formatToDateInput(value) {
            if (!value) return "";
            
            // Decode URI component (in case it's URL encoded)
            const decoded = decodeURIComponent(value);

            // Try to parse MM/DD/YYYY from datetime string
            const parts = decoded.split(" ")[0].split("/"); // [MM, DD, YYYY]
            if (parts.length !== 3) return "";

            const [month, day, year] = parts;
            return `${year}-${month.padStart(2, '0')}-${day.padStart(2, '0')}`; // YYYY-MM-DD
        }

        const startDate = formatToDateInput(rawStartDate);
        const endDate = formatToDateInput(rawEndDate);

            const startInput = document.getElementById("start_date");
            const endInput = document.getElementById("end_date");

            if (startInput && startDate) {
                startInput.value = startDate;
            }

            if (endInput && endDate) {
                endInput.value = endDate;
            }      

            var statusFilter = document.getElementById("staff-filter");
            if (statusFilter) {
                statusFilter.addEventListener("change", function () {
                    if (this.value) {
                        window.location.href = this.value;
                    }
                });
            }

            var sortOrder = document.getElementById("sortOrder");
            if (sortOrder) {
                sortOrder.addEventListener("change", function () {
                    if (this.value) {
                        window.location.href = this.value;
                    }
                });
            }

            var sortOrder = document.getElementById("sortDate");
            if (sortOrder) {
                sortOrder.addEventListener("change", function () {
                    if (this.value) {
                        window.location.href = this.value;
                    }
                });
            }

            var sortOrder = document.getElementById("sortStatus");
            if (sortOrder) {
                sortOrder.addEventListener("change", function () {
                    if (this.value) {
                        window.location.href = this.value;
                    }
                });
            }

            var staffFilter = document.getElementById("project-filter");
            if (staffFilter) {
                staffFilter.addEventListener("change", function () {
                    if (this.value) {
                        window.location.href = this.value;
                    }
                });
            }



        });


      //Multi-Select - User Members
      document.addEventListener("DOMContentLoaded", function () {

          const select = document.getElementById("memberSelect");
          const pillContainer = document.getElementById("selectedPills");

          function renderPills() {
              pillContainer.innerHTML = "";

              Array.from(select.selectedOptions).forEach(opt => {
                  if (opt.value === "") return; // ignore placeholder

                  let pill = document.createElement("span");
                  pill.className = "badge bg-primary d-flex align-items-center px-2 py-1";

                  pill.innerHTML = `
                      ${opt.text}
                      <button type="button" class="btn-close btn-close-white ms-2" style="font-size: .6rem;"></button>
                  `;

                  pill.querySelector("button").addEventListener("click", () => {
                      opt.selected = false;
                      renderPills();
                  });

                  pillContainer.appendChild(pill);
              });
          }

          select.addEventListener("change", renderPills);
      });

</script>

