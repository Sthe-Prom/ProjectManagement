 @section Scripts{
    <script>

          //Edit Project Forms
          const editProjectForms = document.getElementsByClassName("frmEditProject");

          for (const form of editProjectForms) {

              const id = form.getAttribute("id");

              // Using match with regEx
              let num_extr = id.match(/(\d+)/);

              // Display output if number extracted
              if (num_extr) {
                  console.log('number found:' + num_extr[0]);
              }


              //D and G
              const dropZone = document.getElementById("dropZoneEditProject_"+num_extr[0]);
              const fileInput = document.getElementById("ProjectFiles");

              // --- Utils ---
              function highlight() {
                dropZone.classList.add("border-primary", "bg-white");
              }
              function unhighlight() {
                dropZone.classList.remove("border-primary", "bg-white");
              }
              function renderFiles(files) {
                if (!files || files.length === 0) {
                  dropZone.innerHTML = `<p class="mb-1 text-muted">Drop files here or click to browse</p>`;
                  return;
                }

                // Show one or many
                if (files.length === 1) {
                  dropZone.innerHTML = `
                    <p class="mb-1 text-success fw-bold">File attached</p>
                    <small>${files[0].name}</small>
                  `;
                } else {
                  const items = [...files].map(f => `<li>${f.name}</li>`).join("");
                  dropZone.innerHTML = `
                    <p class="mb-1 text-success fw-bold">Files attached (${files.length})</p>
                    <ul class="mb-0 small">${items}</ul>
                  `;
                }
              }

              // --- Open file picker on click (and keyboard) ---
              dropZone.addEventListener("click", () => {
                // Clear first so picking the same file triggers `change`
                fileInput.value = "";
                fileInput.click();
              });

              dropZone.setAttribute("tabindex", "0"); // focusable for keyboard
              dropZone.addEventListener("keydown", (e) => {
                if (e.key === "Enter" || e.key === " ") {
                  e.preventDefault();
                  fileInput.value = "";
                  fileInput.click();
                }
              });

              // --- When user manually selects files ---
              fileInput.addEventListener("change", (e) => {
                const files = e.target.files;
                renderFiles(files);
              });

              // --- Drag events ---
              ["dragenter", "dragover"].forEach(evt =>
                dropZone.addEventListener(evt, (e) => {
                  e.preventDefault();
                  e.stopPropagation();
                  highlight();
                })
              );

              ["dragleave", "drop"].forEach(evt =>
                dropZone.addEventListener(evt, (e) => {
                  e.preventDefault();
                  e.stopPropagation();
                  // For dragleave: avoid flicker by checking relatedTarget
                  if (evt === "dragleave" && dropZone.contains(e.relatedTarget)) return;
                  unhighlight();
                })
              );

              // --- Handle drop ---
              dropZone.addEventListener("drop", (e) => {
                if (e.dataTransfer.files && e.dataTransfer.files.length > 0) {
                  // Assign dropped files to input for normal form submission / FormData
                  fileInput.files = e.dataTransfer.files;
                  renderFiles(e.dataTransfer.files);
                  // Clear the DataTransfer to avoid duplicate events in some browsers
                  e.dataTransfer.clearData();
                }
              });
              //*******************< End Drag and Drop >*********************//

              //UPDATE Project
              $("#btnUpdateProject_"+num_extr[0]).on("click", function() {

                  //var act_id = document.getElementById('projectId_1');
                  //console.log('delete key is:' + num_extr[0]);

                  var formData = new FormData(form);
                  const values = [...formData.entries()];

                  const user_ids = formData.getAll('proj.SelectedAssignedUserIds');

                  var s_user_ids = '';
                  for (const id of user_ids) {
                    s_user_ids += ',' + id;
                  }

                  const file_input = document.getElementById('ProjectFiles');

                  // formData.append("ProjectModel_Id", $("#projectID").val() );
                  formData.append("proj_AccountID",  formData.get('proj.AccountID') );
                  formData.append("proj_ProjectName", formData.get('proj.ProjectName') );
                  formData.append("proj_ProjectDetails", formData.get('proj.ProjectDetails') );
                  formData.append("proj_ProjectAreaOfWork",  formData.get('proj.ProjectAreaOfWork') );
                  formData.append("proj_ProjectWorkInConj",  formData.get('proj.ProjectWorkInConj') );
                  formData.append("proj_SelectedAssignedUserIds", s_user_ids );
                  formData.append("proj_ProjectStartDate",  formData.get('proj.ProjectStartDate') ) ;
                  formData.append("proj_ProjectEndDate",  formData.get('proj.ProjectEndDate') ) ;
                  formData.append("proj_ProjectStatusID", formData.get('proj.ProjectStatusID') );
                  formData.append("proj_ProjectTypeID", formData.get('proj.ProjectTypeID') );
                  //formData.append("ProjectFiles",  formData.get('ProjectFiles') );

                  if (file_input.files.length > 0) {
                    formData.append('ProjectFiles', file_input.files[0]); // name must match server binding
                  }

                  var f = [];
                  //var s = 'Please correct the following: \n---------------------------------\n';
                  var s = '<div style="text-align: center !important;">Please correct the following errors:</div>' + "<hr><br />";

                  var dateStart = formData.get('proj.ProjectStartDate');
                  var dateEnd = formData.get('proj.ProjectEndDate');
                    
                  if(dateEnd < dateStart){
                    s += "Project End Date cannot be earlier than Start Date." + '<br />';
                    f.push('1');
                  }

                  for(i = 0; i < values.length;i++){
                    if((values[i][1] === "" || values[i][1] === 0) && 
                        (values[i][0] != "proj.SelectedAssignedUserIds" ) &&
                        (values[i][0] != "proj.ProjectTypeID" ))// || values[i][1].name == "")
                    {
                      if(values[i][0].includes('.')){
                          s += values[i][0].split('.')[1] + ' is required. <br />';
                          f.push(values[i][1]);
                        }else{
                          s += values[i][0] + ' is required. <br />';
                          f.push(values[i][1]);
                        }

                    }
                  }

                  if(f.length > 0){
                      //validateAddRoadFactorsForm();
                      //alert(s);
                      ProjectAddError('',s);
                      //validatedNew();
                  }else{

                    $.ajax({
                        type: 'POST',
                        url: '@Url.Action("UpdateProject", "Home")' +'/' + num_extr[0],
                        contentType: false,
                        processData: false,
                        cache: false,
                        data: formData,
                        success: projectUpdateSuccess,
                        error: projectUpdateError
                    });

                  }

                  function projectUpdateError(response) {
                      alert("error");
                  }

                  function projectUpdateSuccess(response) {
                      if (response.responseCode == 0) {

                          ProjectEdit("Update Project", "Project Name: " + response.responseMessage
                              + " was added successfully.");
                          //alert("success");
                      }
                      else {
                          alert('Error..');
                      }
                  }

              });

          };     

