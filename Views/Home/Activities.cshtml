@if(Model.Accounts.Where(c => c.Id == userId).FirstOrDefault() != null)
{    
        var all_pojects = from p in Model.Projects
                        join acc in Model.Accounts
                        on p.AccountID equals acc.AccountID
                        //where acc.Id == userId
                    select new {
                      AccountID = p.AccountID,
                      UserID = acc.Id,
                      ProjectID = p.Id,
                      SelectedAssignedUserIds = p.SelectedAssignedUserIds
                    };
      
        var project_lists = new List<int>();
        var activity_lists = new List<int>();    
      
        var currentUser = Model.Accounts.Where(c => c.Id == userId).FirstOrDefault(); 

        foreach(var itemId in all_pojects)
        {
            //Get the ID from Project memberList where the ID's the first item, but contains the currently logged in user.
            bool isUserAssigned = itemId.SelectedAssignedUserIds.Skip(1).Contains(currentUser.AccountID);            

            if(isUserAssigned)
            {
              project_lists.Add(itemId.ProjectID); //Add the list of project where the user is a member assigned to projects.
            }
        }

        var projects_data = from acc in Model.Accounts
                      join proj in Model.Projects
                      on acc.AccountID equals proj.AccountID
                      join stat in Model.Statuses
                      on proj.ProjectStatusID equals stat.Id
                      join p_type in Model.ProjectTypes 
                      on proj.ProjectTypeID equals p_type.Id
                      //where acc.Id == userId ||
                                        //acc.AccountID == proj.SelectedAssignedUserIds[0]
                      //where project_lists.Contains(proj.Id)

                    select new {
                      AccountID = proj.AccountID,
                      ProjectID = proj.Id,
                      ProjectName = proj.ProjectName,
                      ProjectDetails = proj.ProjectDetails,
                      ProjectAreaOfWork = proj.ProjectAreaOfWork,
                      ProjectStartDate = proj.ProjectStartDate,
                      ProjectUpdateTime = proj.ProjectUpdateTime,
                      ProjectEndDate = proj.ProjectEndDate,
                      ProjectWorkInConj = proj.ProjectWorkInConj,
                      ProjectStatusID = proj.ProjectStatusID,
                      ProjectFiles = proj.ProjectFiles,
                      StatusName = stat.StatusName,
                      SelectedAssignedUserIds = proj.SelectedAssignedUserIds,
                      CalculatedDisplayStatusId = proj.CalculatedDisplayStatusId,
                      FirstName = acc.FirstName,
                      ProjectTypeID = p_type.Id,
                      TypeName = p_type.TypeName

                    };         


        var activities_data = from proj in Model.Projects
                        join act in Model.Activities
                        on proj.Id equals act.ProjectID
                        join acc in Model.Accounts
                        on proj.AccountID equals acc.AccountID
                        //where acc.Id == userId
                        //where (project_lists.Contains(act.ProjectID))
                        group new { proj, act }
                            by new { act.Id, act.ProjectID, proj.AccountID, act.ActivityName, act.ActivityComments,
                                act.ActivityChallenges, act.ActivityHighlights, act.ProjectFiles,
                                act.ActivityProgress, act.ActivityUpdateTime, act.ActivityStartDate,
                                act.ActivityEndDate, act.MemberProject }
                        into g
                        select new {
                            Id = g.Key.Id,
                            ProjectID = g.Key.ProjectID,
                            ActivityName = g.Key.ActivityName,
                            ActivityComments = g.Key.ActivityComments,
                            ActivityChallenges = g.Key.ActivityChallenges,
                            ActivityHighlights = g.Key.ActivityHighlights,
                            ActivityStartDate = g.Key.ActivityStartDate,
                            ActivityEndDate = g.Key.ActivityEndDate,
                            ActivityProgress = g.Key.ActivityProgress,
                            ActivityUpdateTime = g.Key.ActivityUpdateTime,
                            ProjectFiles = g.Key.ProjectFiles,
                            MemberProject = g.Key.MemberProject,
                            totalActivities = g.Count(),
                            AccountID = g.Key.AccountID
        };

