                                                              </div>

                                                            </div>

                                                          </div>
                                                        </div>

                                                  </form>
                                                </div>
                                            </div>

                                        }   
                                                                                                    
                                        //var proj = Model.Projects.FirstOrDefault(x => x.Id == ViewBag.Project);  

                                        // Modal Activity (ADD)
                                        <div class="modal modal-md fade" id="modalActivity_@ViewBag.Project" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1" aria-labelledby="staticBackdropLabel" aria-hidden="true">
                                          <div class="modal-dialog modal-xl">
                                              <form enctype="multipart/form-data" class="frm_Activity" id="frm_Activity_@ViewBag.Project" >

                                                  <div class="modal-content">
                                                    <div class="modal-header">
                                                      <div class="flex-row d-flex justify-content-between col-sm-12"> 
                                                          <h1 class="modal-title fs-5 flex-grow-1" id="staticBackdropLabel">Add Activity</h1>
                                                          
