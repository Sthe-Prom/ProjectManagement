                        <div class="table-responsive" style="margin:0;padding:0;"> 
                            
                            <table id="projectsTable" class="table table-striped table-bordered table-hover align-middle" style="margin:0;padding:0;">

                                <thead >
                                    @* HEADER - PROJECT *@
                                    @{
                                      var isUser = projects_data.Any(x => x.AccountID == currentUser.AccountID);
                                      var isAdmin = projects_data.Any(x => x.AccountID == ViewBag.Staff);
                                    }
                                     @if(isUser || isAdmin)
                                      {
                                          <tr class="">                                        
                                              
                                            @{
                                                var proj =  projects_data.FirstOrDefault(x => x.ProjectID == ViewBag.Project);
                                                var tot_act = activities_data.Where(c => c.ProjectID == proj.ProjectID).Count();

                                                var getTTCompletion = proj.ProjectEndDate - proj.ProjectStartDate;

                                                // Option A: Using TimeSpan properties (most common and readable)
                                                int totalDays = getTTCompletion.Days;
                                                int totalWeeks = totalDays / 7;
                                                int totalMonths = totalDays / 30;
                                                int remainingDays = totalDays % 7;

                                                var getProjectMembers = "";
                                                var getProjectOwner = "";                                              
                                                var project_owner_style = "";  

                                                if (proj.SelectedAssignedUserIds.Count() > 0 && proj.SelectedAssignedUserIds != null)
                                                {                                            
                                                    // 2. Split the string by comma

                                                    // 3. Parse each string part into an integer and add to the list
                                                    foreach (var member in proj.SelectedAssignedUserIds)
                                                    {
                                                        var name = Model.Accounts.FirstOrDefault(c => c.AccountID == member);
                                                        getProjectMembers += ", " + name.FirstName ;
                                                    }

                                                    //get Owner name
                                                    var name_owner = Model.Accounts.FirstOrDefault(c => c.AccountID == proj.SelectedAssignedUserIds[0]);
                                                    if(proj.AccountID != currentUser.AccountID && name_owner != null)
                                                    {
                                                        getProjectOwner += " - (" + name_owner.FirstName +")";
                                                    }
                                                }
                                                else
                                                {
                                                    // No users were selected or the input was empty
                                                    var project_owner = Model.Accounts.FirstOrDefault(c => c.Id == userId);
                                                    getProjectMembers = project_owner.FirstName;
                                                }                                               

                                                var AccountID_ = 0;
                                                //Project Owner Style
                                                @if(await userManager.IsInRoleAsync(user,"Admin"))
                                                {
                                                    AccountID_ = ViewBag.Staff;
                                                }
                                                else
                                                {
                                                    AccountID_ = currentUser.AccountID;
                                                }

                                                if(proj.AccountID == AccountID_)
                                                {
                                                  project_owner_style = "background-color:#0F204B;opacity:0.8;color:#fff;";
                                                }
                                                else
                                                {
                                                  project_owner_style = "background-color:#c59217;opacity:1;color:#fff;";
                                                }                                          

                                              @* PROJECT *@
                                              <td colspan="100%" style="@project_owner_style" >

                                                    <div class="align-middle accordion accordion-flush" id="accordionFlush" style="background-color: transparent !important;background: none !important;">
                                                    
                                                    <div class="accordion-item" style="background-color:#0F204B;opacity:0.8;color:#fff;">

                                                      @* Main *@
                                                      <div class="d-flex flex-row justify-content-between ufs_container">

                                                        @* Project Name *@
                                                        <div class="col-sm-6" >                                                      
                                                            <span class="accordion-button collapsed fw-semibold" data-bs-toggle="collapse" data-bs-target="#flush-collapse_@proj.ProjectID" aria-expanded="true" aria-controls="project-flush-collapse">
                                                              <span class="fw-bold">@proj.ProjectName @getProjectOwner</span>
                                                            </span>
                                                        </div>

                                                        @* Project Members *@
                                                        <div class="col-sm-2 d-none d-lg-block align-content-center" 
                                                              style="background-color:#3D4A6B;border:1px solid grey;border-radius:4px;vertical-align:middle;width:110px;"
                                                              data-bs-toggle="tooltip" data-bs-placement="top" 
                                                              title="@getProjectMembers.Substring(1)"
                                                            >

                                                            <span class="ps-2 pe-2" style="display: inline-flex; align-items: center;">
                                                                <i class="bi bi-people-fill fs-6"></i>
                                                                <span style="margin-left: 0.30rem;font-weight:100">@proj.SelectedAssignedUserIds.Count() Members</span>
                                                            </span>

                                                        </div>

                                                        @* Project Duration *@
                                                        <div class="col-sm-2 d-none d-lg-block align-content-center" style="background-color:#3D4A6B;border:1px solid grey;border-radius:4px;vertical-align:middle;width:110px;">
                                                          
                                                          @if(totalDays <= 0)
                                                          {
                                                            <span class="ps-3" style="display: inline-flex; align-items: center;">
                                                                <i class="bi bi-clock-history fs-6"></i>
                                                                <span style="margin-left: 0.30rem;font-weight:100">1 Day</span>
                                                            </span>
                                                          }else
                                                            if(totalDays > 0 && totalDays <= 7)
                                                            {
                                                              <span class="ps-3" style="display: inline-flex; align-items: center;">
                                                                  <i class="bi bi-clock-history fs-6"></i>
                                                                  <span style="margin-left: 0.30rem;font-weight:100">@totalDays Days</span>
                                                              </span>
                                                            }else
                                                                if(totalDays > 7 && totalWeeks <= 5 )
                                                                {

                                                                  <span class="ps-3" style="display: inline-flex; align-items: center;">
                                                                    <i class="bi bi-clock-history fs-6"></i>
                                                                    <span style="margin-left: 0.30rem;font-weight:100">@totalWeeks Weeks</span>
                                                                  </span>

                                                                }
                                                                else
                                                                  if(totalWeeks > 5 )
                                                                  {
                                                                        int months = 0;
                                                                        DateTime endDate = proj.ProjectEndDate;
                                                                        DateTime startDate = proj.ProjectStartDate;
                                                                        while(startDate < endDate)
                                                                        {
                                                                          DateTime checkDate = startDate.AddMonths(1);
                                                                          if(checkDate <= endDate)
                                                                          {
                                                                              months++;
                                                                              startDate = checkDate;
                                                                          }
                                                                          else
                                                                          {
                                                                              break;
                                                                          }
                                                                        }

                                                                      <span class="ps-3" style="display: inline-flex; align-items: center;">
                                                                        <i class="bi bi-clock-history fs-6"></i>
                                                                        <span style="margin-left: 0.30rem;font-weight:100">@months Month</span>
                                                                      </span>
                                                                  }

                                                        </div>

                                                        @* Project Status *@
                                                        <div class="col-sm-2" style="background-color:#3D4A6B;border:1px solid grey;border-radius:4px;vertical-align:middle;width:120px;" >

                                                            @{
                                                                  var act_statues = Model.Projects.Where(a => a.Id == proj.ProjectID);
                                                                
                                                                  int displayStatusId = proj.CalculatedDisplayStatusId;
                                                                                                                    
                                                                      @if(displayStatusId == (int)ProjectActivityStatus.Started) // Assumes ProjectActivityStatus enum is accessible
                                                                      {
                                                                          <div class="progress" style="height:100%;" >
                                                                              <div class="progress-bar" role="progressbar" style="width: 30%;" aria-valuenow="30" aria-valuemin="0" aria-valuemax="100">30%</div>
                                                                          </div>
                                                                      }
                                                                      else if(displayStatusId == (int)ProjectActivityStatus.Upcoming)
                                                                      {
                                                                          <div class="progress" style="height:100%;" >
                                                                              <div class="progress-bar progress-bar-striped bg-info progress-bar-animated" role="progressbar" style="width: 5%;" aria-valuenow="5" aria-valuemin="0" aria-valuemax="100">5%</div>
                                                                          </div>
                                                                      }
                                                                      else if(displayStatusId == (int)ProjectActivityStatus.Ongoing)
                                                                      {
                                                                          <div class="progress" style="height:100%;" >
                                                                              <div class="progress-bar bg-warning" role="progressbar" style="width: 50%;" aria-valuenow="50" aria-valuemin="0" aria-valuemax="100">50%</div>
                                                                          </div>
                                                                      }
                                                                      else if(displayStatusId == (int)ProjectActivityStatus.Completed)
                                                                      {
                                                                          <div class="progress" style="height:100%;" >
                                                                              <div class="progress-bar bg-success" role="progressbar" style="width: 100%;" aria-valuenow="100" aria-valuemin="0" aria-valuemax="100">100%</div>
                                                                          </div>
                                                                      }
                                                                      else if(displayStatusId == (int)ProjectActivityStatus.Incomplete)
                                                                      {
                                                                          <div class="progress" style="height:100%;" >
                                                                              <div class="progress-bar bg-danger" role="progressbar" style="width: 15%;" aria-valuenow="15" aria-valuemin="0" aria-valuemax="100">15%</div> @* Note: You have 15% here but aria-valuenow is 25%*@ 
                                                                          </div>
                                                                      }
                                                                      else if(displayStatusId == (int)ProjectActivityStatus.OnHold)
                                                                      {
                                                                          <div class="progress" style="height:100%;" >
                                                                              <div class="progress-bar bg-secondary" role="progressbar" style="width: 20%;" aria-valuenow="20" aria-valuemin="0" aria-valuemax="100">20%</div>
                                                                          </div>
                                                                      }
                                                                      else if(displayStatusId == (int)ProjectActivityStatus.SentForReview)
                                                                      {
                                                                          <div class="progress" style="height:100%;" >
                                                                              <div class="progress-bar bg-info" role="progressbar" style="width: 80%;" aria-valuenow="80" aria-valuemin="0" aria-valuemax="100">80%</div>
                                                                          </div>
                                                                      }
                                                                    
                                                                }

                                                        </div>

                                                        @* Project Actions *@
                                                        <div class="col-auto d-none d-lg-block" style="vertical-align:middle;float:right;">

                                                          <ul class="list-unstyled d-flex" style="margin:0;padding:0;border:1px solid grey;border-radius:4px;">
                                                              @* Add Project *@
                                                              <li class="align-middle ps-4 pe-4" style="margin:0;padding:0;display: inline-flex; align-items: center;" data-bs-toggle="modal" data-bs-target="#modalActivity_@proj.ProjectID">
                                                                  <span class="clip" style="color: blue;">
                                                                    <i class="bi bi-plus-circle"></i>
                                                                  </span>
                                                              </li>

                                                              @{
                                                                  //Project Owner Action
                                                                  if(proj.AccountID == currentUser.AccountID)
                                                                  {

                                                                    @* Edit Project *@
                                                                    <li class="align-middle ps-4 pe-4" style="margin:0;padding:0;display: inline-flex; align-items: center;" data-bs-toggle="modal" data-bs-target="#modalProjectEdit_@proj.ProjectID">
                                                                      <span class="safe" style="color: green;">
