                                  <div class="sub pb-2 fw-bold">In Progress</div>
                                  <span style="border-radius:50%; background-color:rgba(233, 131, 0, 0.3); padding: 10px 15px; display: inline-block;">
                                      <i style="color:#e98300;font-size:24px;" class="bi bi-activity"></i>                                      
