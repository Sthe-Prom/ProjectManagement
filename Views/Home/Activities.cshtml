                                                                    <input type="date" asp-for="@Model.ActivityModel.ActivityEndDate" class="form-control"  />
                                                                </div>
                                                              </div>

                                                        
                                                              @* <!-- Drag & Drop Upload --> *@
                                                              <div class="form-group mb-3">
                                                                  <label class="col-form-label fw-bold">
                                                                      Activity Attachments:
                                                                  </label>

                                                                  <div id="dropZoneAddActivity_@ViewBag.Project"
                                                                      class="p-3 border border-secondary rounded text-center bg-light"
