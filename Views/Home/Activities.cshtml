                      //ActivityAddError(response.responseMessage);
                    }
                  }

                  function activitySuccess(response) {
                      if (response.responseCode == 0) {

                          ActivityAdd("Add Activity", "Activity Name: " + response.responseMessage
                              + " was added successfully.");
                          //alert("Activity Added Successfully.");
                      }
                      else {
                          alert(response.responseMessage);
                      }
                  }


              });                 

              //DELETE Project
              $("#btnDeleteProject_"+num_extr[0]).on("click", function() {

                      swal({
                          title: "Are you sure?",
                          text: "Projects deleted cannot be recovered",
                          type: "warning",
                          showCancelButton: true,
                          confirmButtonColor: "#DD6B55",
                          confirmButtonText: "Yes, delete Project!",
                          cancelButtonText: "No, cancel!",
                          closeOnConfirm: false,
                          closeOnCancel: false
                          },
                          function (isConfirm) {
                              if (isConfirm) {
                                      $.ajax({
                                          type: 'DELETE',
                                          url: '@Url.Action("DeleteProject", "Home")' +'/' + num_extr[0],
                                          cache: false

                                      });

                                      swal({
                                          title: "Deleted",
                                          text: "Selected Project has been deleted.",
                                          type: "success",
                                          confirmButtonColor: "#0F204B",
                                          confirmButtonText: "Okay",
                                          closeOnConfirm: false,
                                          html: true
                                      },
                                        function(){
                                              location.reload();
                                          });


                              } else {
                                  swal("Cancelled", "No Projects Deleted:)", "error");
                              }
                          });

              });

          };

          //Activity (All) (Edit + Delete) Forms
          const allActivityForms = document.getElementsByClassName("act_form");

          for (const form of allActivityForms) {

              const id = form.getAttribute("id");

              // Using match with regEx
              let num_extr = id.match(/(\d+)/);
              console.log("Key for Edit: " + num_extr[0]);

              //D and G
              const dropZone = document.getElementById("dropZoneUpdateActivity_"+num_extr[0]);
              const fileInput = document.getElementById("ProjectFiles");

              // --- Utils ---
              function highlight() {
                dropZone.classList.add("border-primary", "bg-white");
              }
              function unhighlight() {
                dropZone.classList.remove("border-primary", "bg-white");
              }
              function renderFiles(files) {
                if (!files || files.length === 0) {
                  dropZone.innerHTML = `<p class="mb-1 text-muted">Drop files here or click to browse</p>`;
                  return;
                }

                // Show one or many
                if (files.length === 1) {
                  dropZone.innerHTML = `
                    <p class="mb-1 text-success fw-bold">File attached</p>
                    <small>${files[0].name}</small>
                  `;
                } else {
                  const items = [...files].map(f => `<li>${f.name}</li>`).join("");
                  dropZone.innerHTML = `
                    <p class="mb-1 text-success fw-bold">Files attached (${files.length})</p>
                    <ul class="mb-0 small">${items}</ul>
                  `;
                }
              }

              // --- Open file picker on click (and keyboard) ---
              dropZone.addEventListener("click", () => {
                // Clear first so picking the same file triggers `change`
                fileInput.value = "";
                fileInput.click();
              });

              dropZone.setAttribute("tabindex", "0"); // focusable for keyboard
              dropZone.addEventListener("keydown", (e) => {
                if (e.key === "Enter" || e.key === " ") {
                  e.preventDefault();
                  fileInput.value = "";
                  fileInput.click();
                }
              });

              // --- When user manually selects files ---
              fileInput.addEventListener("change", (e) => {
                const files = e.target.files;
                renderFiles(files);
              });

              // --- Drag events ---
              ["dragenter", "dragover"].forEach(evt =>
                dropZone.addEventListener(evt, (e) => {
                  e.preventDefault();
                  e.stopPropagation();
                  highlight();
                })
              );

              ["dragleave", "drop"].forEach(evt =>
                dropZone.addEventListener(evt, (e) => {
                  e.preventDefault();
                  e.stopPropagation();
                  // For dragleave: avoid flicker by checking relatedTarget
                  if (evt === "dragleave" && dropZone.contains(e.relatedTarget)) return;
                  unhighlight();
                })
              );

              // --- Handle drop ---
              dropZone.addEventListener("drop", (e) => {
                if (e.dataTransfer.files && e.dataTransfer.files.length > 0) {
                  // Assign dropped files to input for normal form submission / FormData
                  fileInput.files = e.dataTransfer.files;
                  renderFiles(e.dataTransfer.files);
                  // Clear the DataTransfer to avoid duplicate events in some browsers
                  e.dataTransfer.clearData();
                }
              });
              //*******************< End Drag and Drop >*********************//


                //UPDATE Activity
              $("#btnUpdateActivity_"+num_extr[0]).on("click", function() {

                  var formData_act = new FormData(form);
                  const values = [...formData_act.entries()];

                  const file_input = document.getElementById('ProjectFiles');

                  formData_act.append("act_ActivityName",  formData_act.get('act.ActivityName')  );
