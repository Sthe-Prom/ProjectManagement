                                        '#ff771d', // Orange
                                        '#a366ff', // Purple
                                        '#ffd700', // Gold
                                        '#00ced1', // DarkTurquoise
                                        '#ff6347', // Tomato
                                        '#6a5acd', // SlateBlue
                                        '#8b0000', // DarkRed
