                                <div class="card-icon rounded-circle d-flex align-items-center justify-content-center">
                                  <i class="bi bi-folder2"></i>
                                </div>    

                                  <span class="d-inline-flex align-items-center px-2 border-end">                                            
                                    @* Total *@
                                     @{
                                          var p = from p_ in Model.Projects
                                                select new {
                                                  p_.Id
                                                };
                                        }
                                    <div class="flex-column mb-0">

                                      <h6 class=""> @p.Count()</h6>
                                      <span class="text-primary small fw-bold">
                                        @{
                                            var completed_proj = Model.Projects.Where(p => p.ProjectStatusID == 4).ToList();
                                            double getPerc_proj = 0;
                                            if(p.Count() > 0)
                                            {
                                              getPerc_proj = ((double)completed_proj.Count / p.Count()) *100;
                                            }
                                          }
                                          @getPerc_proj.ToString("F2")%
                                      </span>
                                      <span class="text-muted small px-2">
                                        <i class="bi bi-check-circle-fill text-success"></i>
                                      </span>
                                      
                                    </div>
                                      
                                  </span>                         
                              
                                  <div class="mb-0">

                                      @* Long‑term: *@
                                      <span class="d-inline-flex align-items-center px-2 border-end">
                                        <small class="text-secondary me-1">Long‑term:</small> <h6 class="">@projects_data_admin.Count(x => x.ProjectTypeID == 1)</h6>
                                      </span>

                                      @* Ad hoc: *@
                                      <span class="d-inline-flex align-items-center">
                                        <small class="text-secondary me-1">Ad hoc:</small> <h6 class="">@projects_data_admin.Count(x => x.ProjectTypeID == 2)</h6>
                                      </span>

                                      @* KPI Related *@
                                      <span class="d-inline-flex align-items-center px-2 mx-2 border-start" title="KPI Related Projects" data-bs-toggle="tooltip" data-bs-placement="top" >                                          
                                          
                                          <div class="card-icon rounded-circle d-flex align-items-center justify-content-center" style="background-color: rgba(255, 193, 7, 0.1);" >
                                            <i class="bi bi-stars" style="color: #FFD700;"></i>
                                          </div>

                                          <div class="ps-3">
                                            <h6>
        
                                              @{
                                                var kpi_related = from proj in Model.Projects
                                                        join kpi in Model.KPIs
                                                        on proj.ProjectKPI equals kpi.Id                                                      
                                                        where kpi.Id != 26
                                                        select new {
                                                          kpi.Id,
                                                          kpi.KPIName,
                                                          ProjectID = proj.Id,
                                                          ProjectStatusID = proj.ProjectStatusID
                                                        };

                                              }                                   
                                              @kpi_related.Count()
                                            </h6>
                                            <span class="text-success small pt-1 fw-bold">
                                              @{
                                                var completed_kpi_proj = kpi_related.Where(p => p.ProjectStatusID == 4).ToList();
                                                double getPerc_ = 0;
                                              
                                                if(kpi_related.Count() > 0)
                                                {
                                                  getPerc_ = ((double)completed_kpi_proj.Count / kpi_related.Count()) * 100;
                                                }
                                              }
                                              @getPerc_.ToString("F2")%
                                              
                                            </span>
                                            <span class="text-muted small pt-2 ps-1">
                                              <i class="bi bi-check-circle-fill text-success"></i>
                                            </span>
                                          </div>

                                      </span>     
                                     
                                  </div>

                              </div>
                            </div>
                          </div>
