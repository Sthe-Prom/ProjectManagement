                                                      <li class="file-item" data-filename="@act_.ProjectFiles" data-bs-toggle="tooltip" data-bs-placement="top" title="@fileName">
                                                        <a href="~/Attachments/Activity/@act_.ProjectFiles"  class="clip" download>
                                                            <i class="bi fs-5"></i>
                                                        </a>
                                                      </li>
                                                    }
                                                    else
                                                    {
                                                      <li class="file-item" data-filename="@act_.ProjectFiles" data-bs-toggle="tooltip" data-bs-placement="top" title="No attachments for this project.">
