                                                      @* Attachments *@
                                                      @if(!String.IsNullOrEmpty(act.ProjectFiles) && act.ProjectFiles.Contains('.'))
                                                      {
                                                        string fileName = act.ProjectFiles.Length >= 3 ? act.ProjectFiles.Substring(4) : act.ProjectFiles;
                                                        <li class="file-item" data-filename="@act.ProjectFiles" data-bs-toggle="tooltip" data-bs-placement="top" title="@fileName">
                                                          <a href="~/Attachments/Activity/@act.ProjectFiles" class="clip" download>
                                                              <i class="bi fs-6"></i>
                                                          </a>
                                                        </li>
                                                      }
                                                      else
                                                      {
                                                        <li class="file-item" data-filename="@act.ProjectFiles" data-bs-toggle="tooltip" data-bs-placement="top" title="No attachments for this Activity.">
                                                          <a class="" aria-disabled="true" disabled>
                                                              <i class="bi fs-6" style="color:lightgray;"></i>
                                                          </a>
                                                        </li>
                                                      }


                                                    </ul>

                                                    
                                                    <script>

                                                        (function () {
                                                          const map = {
                                                            image: [".jpg",".jpeg",".png",".gif",".bmp",".tiff",".webp"],
                                                            word: [".doc",".docx"],
                                                            pdf: [".pdf"],
                                                            excel: [".xls",".xlsx",".csv"],
                                                            ppt: [".ppt",".pptx"],
                                                            zip: [".zip",".rar",".7z"],
                                                            text: [".txt",".md"],
                                                            play: [".mp4",".mov",".avi",".mkv"],
                                                            music: [".mp3",".wav",".flac"]
                                                          };

                                                          const getIcon = (ext) => {
                                                            ext = (ext || "").toLowerCase();
                                                            if (map.image.includes(ext)) return "bi-file-earmark-image";
                                                            if (map.word.includes(ext)) return "bi-file-earmark-word";
                                                            if (map.pdf.includes(ext)) return "bi-file-earmark-pdf";
                                                            if (map.excel.includes(ext)) return "bi-file-earmark-excel";
                                                            if (map.ppt.includes(ext)) return "bi-file-earmark-ppt";
                                                            if (map.zip.includes(ext)) return "bi-file-earmark-zip";
                                                            if (map.text.includes(ext)) return "bi-file-earmark-text";
                                                            if (map.play.includes(ext)) return "bi-file-earmark-play";
                                                            if (map.music.includes(ext)) return "bi-file-earmark-music";
                                                            return "bi-file-earmark";
                                                          };

                                                          document.querySelectorAll(".file-item").forEach(li => {
                                                            const filename = li.getAttribute("data-filename") || "";
                                                            const ext = filename.substring(filename.lastIndexOf("."));
                                                            const i = li.querySelector("i.bi");
                                                            i.classList.add(getIcon(ext));
                                                          });
                                                        })();

                                                    </script>


