                        </div>

                        <div class="card-body">
                          <h5 class="card-title">Recent Projects <span>| All</span></h5>

                          <div class="activity overflow-auto" style="height: 380px;">

                            @{
                              var recent_projects = from rec_proj in Model.Projects
                                            select new {
                                              rec_proj.Id,
                                              rec_proj.ProjectName,
                                              rec_proj.ProjectDetails,
                                              rec_proj.ProjectAreaOfWork,
                                              rec_proj.ProjectUpdateTime,
                                              rec_proj.ProjectStartDate
                                            };


                            }

                            @foreach(var rec_p in recent_projects.OrderByDescending(p => p.ProjectUpdateTime).Take(10))
                            {
                                DateTime now = DateTime.UtcNow;
                                DateTime prevDate = rec_p.ProjectUpdateTime;
                                TimeSpan durationFixed = now.Subtract(prevDate);

                                double totalMinutes = durationFixed.TotalMinutes;
                                var col = "";
                                var timeDis = 0;

                                <div class="activity-item d-flex">
                                  <div class="activite-label">
                                    @*ActivityUpdateTime.Minute *@

                                    @if(totalMinutes <= 60)
                                      {
                                        <span class="" style="display: inline-flex; align-items: center;">
                                            <span class="text-muted small">@Convert.ToInt32(totalMinutes) mins</span>
                                        </span>
                                        col = "text-success";
                                      }else
                                        if(totalMinutes > 60 && (totalMinutes <= 1440) )
                                        {
                                          timeDis = Convert.ToInt32(totalMinutes/60);
                                          <span class="" style="display: inline-flex; align-items: center;">
                                              <span class="text-muted small">@timeDis hrs</span>
                                          </span>
                                          col = "text-warning";
                                        }else
                                          if(totalMinutes > 1440 && (totalMinutes < 10080) )
                                          {
                                              timeDis = Convert.ToInt32(totalMinutes / 1440);
                                              <span class="" style="display: inline-flex; align-items: center;">
                                                <span class="text-muted small">@timeDis dys</span>
                                              </span>
                                              col = "text-info";
                                          }
                                          else
                                            if(totalMinutes > 10080 && (totalMinutes < 40320) )
                                            {
                                                timeDis = Convert.ToInt32(totalMinutes / 10080);
                                                <span class="" style="display: inline-flex; align-items: center;">
                                                  <span class="text-muted small">@timeDis wks</span>
                                                </span>
                                                col = "text-primary";
                                            }
                                            else
                                            if(totalMinutes > 40320 && (totalMinutes < 40320*2) )
                                            {                                              
                                                <span class="" style="display: inline-flex; align-items: center;">
                                                  <span class="text-muted small"> 1 mon</span>
                                                </span>
                                                col = "text-secondary";
                                            }else
                                            if(totalMinutes > 40320 && (totalMinutes < 40320*3) )
                                            {                                             
                                                <span class="" style="display: inline-flex; align-items: center;">
                                                  <span class="text-muted small"> 2 mos</span>
                                                </span>
                                                col = "text-lightgrey";
                                            }
                                            else
                                            {                            
                                                <span class="" style="display: inline-flex; align-items: center;">
                                                  <span class="text-muted small"> Reported</span>
                                                </span>
                                                col = "text-lightgrey";
