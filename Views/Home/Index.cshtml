                                      <span class="fw-bold small text-uppercase" style="color:#490e6f;">@rec_p.ProjectAreaOfWork.</span>
                                    }                           
                                  </div>
                                </div>
                                @*End activity item*@
                            }

                          </div>
                        </div>
                      </div>
