                                document.addEventListener("DOMContentLoaded", () => {

                                    const barColors = [
                                        '#4154f1', // Blue
                                        '#2eca6a', // Green
                                        '#ff771d', // Orange
                                        '#a366ff', // Purple
                                        '#ffd700', // Gold
                                        '#00ced1', // DarkTurquoise
                                        '#ff6347', // Tomato
                                        '#6a5acd', // SlateBlue
                                        '#8b0000', // DarkRed
                                        '#20b2aa'  // LightSeaGreen
                                        // Add more colors as needed
                                    ];

                                  // Get the chart container element
                                  const projectsChartDOM = document.querySelector("#projectsContainer");

                                  //Initialize the eCharts instance
                                  const projectsChart = echarts.init(projectsChartDOM);

                                  projectsChart
                                    .setOption({
                                      tooltip: {
                                        trigger: "item",
                                      },
                                      legend: {
                                        top: "0%",
                                        left: "center",
                                      },
                                      // --- X-Axis Configuration ---
                                      xAxis: {
                                          type: 'category', // Defines it as a category axis
                                          data: @Html.Raw(ViewBag.ProjectCategories), // You'll need to provide categories from your C# backend
                                          axisLabel: {
                                              // Optional: Rotate labels if they are long and overlap
                                              // rotate: 45
                                          }
                                      },
                                      // --- Y-Axis Configuration ---
                                      yAxis: {
                                          type: 'value', // Defines it as a value axis for numerical data
                                          interval: 1,
                                          axisLabel: {
                                              formatter: function (value) {
                                                  return Math.round(value); // Ensures integer display for y-axis labels
                                              }
                                          }
                                      },
                                      series: [
                                        {
                                          type: "bar",
                                          itemStyle: {
                                            color: function(params){
                                                return barColors[params.dataIndex % barColors.length];
                                            }
                                          },
                                          radius: ["40%", "70%"],
                                          avoidLabelOverlap: false,
                                          label: {
                                            show: false,
                                            position: "center",
                                          },
                                          emphasis: {
                                            label: {
                                              show: true,
                                              fontSize: "18",
                                              fontWeight: "bold",
                                            },
                                          },
                                          labelLine: {
                                            show: true,
                                          },

                                          data: @Html.Raw(ViewBag.projectValues)
                                        },
                                      ],
                                    });

                                      window.addEventListener('resize', function () {
                                        // Call the resize method on the chart instance
                                        projectsChart.resize();
                                    });

                                });


                              </script>

                              @*End Line Chart *@
                            </div>
                          </div>
                        </div>
