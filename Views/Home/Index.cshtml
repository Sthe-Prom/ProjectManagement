                                        <span class="">
                                            <i class="bi bi-trash3"></i>
                                        </span>
                                      </li>
                                    }
                                  
                                  </ul>
                                </td>

                            </tr>

                            // Modal Activity
                            <div class="modal modal-md fade" id="modalActivity_@proj.Id" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1" aria-labelledby="staticBackdropLabel" aria-hidden="true">
