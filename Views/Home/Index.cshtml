                                                            <div class="col-sm-2 ps-3 pe-3" style="border-right:1px solid grey;">
                                                              <h6 class="fw-semibold mb-1" style="color:#a71930;">Project Members</h6>
                                                              <p class="fw-light">@getProjectMembers.Substring(1)</p>
