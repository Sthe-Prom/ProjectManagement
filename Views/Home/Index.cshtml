 @section Scripts{
    <script>

        $(document).ready(function() {

                //Save Project
                $("#btnSaveProject").on("click", function() {

                    var formData = new FormData(frmAddProject);
                    const values = [...formData.entries()];
                    const user_ids = formData.getAll('ProjectModel.SelectedAssignedUserIds');

                    var s_user_ids = '';
                    for (const id of user_ids) {
                      s_user_ids += ',' + id;
                    }

                    const file_input = document.getElementById('ProjectFiles');

                    formData.append("ProjectModel_ProjectName", $("#ProjectModel_ProjectName").val() );
                    formData.append("ProjectModel_ProjectDetails",  $("#ProjectModel_ProjectDetails").val() );
                    formData.append("ProjectModel_ProjectAreaOfWork",  $("#ProjectModel_ProjectAreaOfWork").val() );
                    formData.append("ProjectModel_ProjectWorkInConj",  $("#ProjectModel_ProjectWorkInConj").val() );
                    formData.append("ProjectModel_SelectedAssignedUserIds", user_ids);
                    formData.append("ProjectModel_ProjectStartDate",  $("#ProjectModel_ProjectStartDate").val() ) ;
                    formData.append("ProjectModel_ProjectEndDate",  $("#ProjectModel_ProjectEndDate").val() ) ;
                    formData.append("ProjectModel_ProjectStatusID", $("#ProjectModel_ProjectStatusID").val() );
                    formData.append("ProjectModel_AccountID",  $("#ProjectModel_AccountID").val() );
                    formData.append("ProjectModel_ProjectTypeID",  $("#ProjectModel_ProjectTypeID").val() );
                    formData.append("ProjectModel_ProjectKPI",  $("#ProjectModel_ProjectKPI").val() );
                    
                    if (file_input.files.length > 0) {
                      formData.append('ProjectFiles', file_input.files[0]); // name must match server binding
                    }
              
                    var f = [];
                    var s = '<div style="text-align: center !important;">Please correct the following errors:</div>' + "<hr><br />";

                    var dateStart = formData.get('ProjectModel.ProjectStartDate');
                    var dateEnd = formData.get('ProjectModel.ProjectEndDate');
                       
                    if(dateEnd < dateStart){
                      s += "Project End Date cannot be earlier than Start Date." + '<br />';
                      f.push('1');
                    }

                    for(i = 0; i < values.length;i++){
                      if(values[i][1] === "" 
                        && values[i][0] !== 'ProjectModel.SelectedAssignedUserIds' 
                        && values[i][0] !== 'ProjectModel.ProjectKPI' )// || values[i][1].name == "")
                      {
                                     
                        if(values[i][0].includes('.')){
                            s += values[i][0].split('.')[1] + ' is required. <br />';
                            f.push(values[i][1]);
                          }else{
                            s += values[i][0] + ' is required. <br />';
                            f.push(values[i][1]);
                          }

                      }

                    }

                    if(f.length > 0){
                        ProjectAddError('',s);
                    }
                    else{

                      $.ajax({
                          type: 'POST',
                          url: '@Url.Action("AddProjectAjax", "Home")',
                          contentType: false,
                          processData: false,
                          cache: false,
                          data: formData,
                          success: projectAddSuccess,
                          error: projectAddError
                      });

                    }
                    
                    function projectAddError(response) {
                        //alert(response.responseMessage);
                        ProjectAddError('',response.responseMessage);
                    }

                    function projectAddSuccess(response) {
                        if (response.responseCode == 0) {

                            ProjectAdd("Add Project", "Project Name: " + response.responseMessage
                              + " was added successfully.");
                            //alert("Project Added Successfully");
                        }
                        else {
                            alert(response.responseMessage);
                        }
                    }

                });


                //Edit Project Forms
                const editProjectForms = document.getElementsByClassName("frmEditProject");

                for (const form of editProjectForms) {

                    const id = form.getAttribute("id");

                    // Using match with regEx
                    let num_extr = id.match(/(\d+)/);

                    // Display output if number extracted
                    if (num_extr) {
                        console.log('number found:' + num_extr[0]);
                    }

                    //D and G
                    const dropZone = document.getElementById("dropZoneEditProject_"+num_extr[0]);
                    const fileInput = document.getElementById("ProjectFiles");

                    // --- Utils ---
                    function highlight() {
                      dropZone.classList.add("border-primary", "bg-white");
                    }
                    function unhighlight() {
                      dropZone.classList.remove("border-primary", "bg-white");
                    }
                    function renderFiles(files) {
                      if (!files || files.length === 0) {
                        dropZone.innerHTML = `<p class="mb-1 text-muted">Drop files here or click to browse</p>`;
                        return;
                      }

                      // Show one or many
                      if (files.length === 1) {
                        dropZone.innerHTML = `
                          <p class="mb-1 text-success fw-bold">File attached</p>
                          <small>${files[0].name}</small>
                        `;
                      } else {
                        const items = [...files].map(f => `<li>${f.name}</li>`).join("");
                        dropZone.innerHTML = `
                          <p class="mb-1 text-success fw-bold">Files attached (${files.length})</p>
                          <ul class="mb-0 small">${items}</ul>
                        `;
                      }
                    }

                    // --- Open file picker on click (and keyboard) ---
                    dropZone.addEventListener("click", () => {
                      // Clear first so picking the same file triggers `change`
                      fileInput.value = "";
                      fileInput.click();
                    });

                    dropZone.setAttribute("tabindex", "0"); // focusable for keyboard
                    dropZone.addEventListener("keydown", (e) => {
                      if (e.key === "Enter" || e.key === " ") {
                        e.preventDefault();
                        fileInput.value = "";
                        fileInput.click();
                      }
                    });

                    // --- When user manually selects files ---
                    fileInput.addEventListener("change", (e) => {
                      const files = e.target.files;
                      renderFiles(files);
                    });

                    // --- Drag events ---
                    ["dragenter", "dragover"].forEach(evt =>
                      dropZone.addEventListener(evt, (e) => {
                        e.preventDefault();
                        e.stopPropagation();
                        highlight();
                      })
                    );

                    ["dragleave", "drop"].forEach(evt =>
                      dropZone.addEventListener(evt, (e) => {
                        e.preventDefault();
                        e.stopPropagation();
                        // For dragleave: avoid flicker by checking relatedTarget
                        if (evt === "dragleave" && dropZone.contains(e.relatedTarget)) return;
                        unhighlight();
                      })
                    );

                    // --- Handle drop ---
                    dropZone.addEventListener("drop", (e) => {
                      if (e.dataTransfer.files && e.dataTransfer.files.length > 0) {
                        // Assign dropped files to input for normal form submission / FormData
                        fileInput.files = e.dataTransfer.files;
                        renderFiles(e.dataTransfer.files);
                        // Clear the DataTransfer to avoid duplicate events in some browsers
                        e.dataTransfer.clearData();
                      }
                    });
                    //*******************< End Drag and Drop >*********************//

                    //UPDATE Project
                    $("#btnUpdateProject_"+num_extr[0]).on("click", function() {

                        //var act_id = document.getElementById('projectId_1');
                        //console.log('delete key is:' + num_extr[0]);

                        var formData = new FormData(form);
