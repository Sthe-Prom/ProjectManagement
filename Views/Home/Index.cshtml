<script>

       document.addEventListener('DOMContentLoaded', function() {
          const filterLinks = Array.from(document.getElementsByClassName('users')); // Convert HTMLCollection to Array

          // Define initial styles and event listeners for each link
          filterLinks.forEach(linkElement => {
              // Set initial styles (better to do this in CSS, but keeping it for consistency with your original intent)
              linkElement.style.fontSize = "16px";
              linkElement.style.color = "white";

              // Add hover effect using classes
              linkElement.addEventListener('mouseover', function() {
                  linkElement.classList.add('link-hover');
              });

              linkElement.addEventListener('mouseout', function() {
                  linkElement.classList.remove('link-hover');
              });

              // Add click behavior for active state
              linkElement.addEventListener('click', function(event) {
                 // event.preventDefault(); // Prevent default link behavior (e.g., navigating away) if desired

                  // Remove 'link-active' from all other links
                  filterLinks.forEach(otherLink => {
                      if (otherLink !== linkElement) {
                          otherLink.classList.remove('link-active');
                          // You might want to reset their initial styles here if not handled by CSS default
                          otherLink.style.fontSize = "16px";
                          otherLink.style.fontWeight = "normal"; // Reset font weight
                      }
                  });

                  // Toggle 'link-active' on the clicked link
                  linkElement.classList.toggle('link-active');

                  // Apply specific styles for the active link directly (if not fully managed by CSS)
                  // This part might be redundant if 'link-active' class handles all styling.
                  if (linkElement.classList.contains('link-active')) {
                      linkElement.style.fontSize = "22px";
                      linkElement.style.fontWeight = "bold";
                  } else {
                      // If it's toggled off, reset to initial state
                      linkElement.style.fontSize = "16px";
                      linkElement.style.fontWeight = "normal";
                  }

                  // Optional: You can put your navigation logic here, e.g.,
                  // window.location.href = linkElement.href;
              });
          });
      });

