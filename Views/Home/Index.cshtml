                                                      @act_.ActivityStartDate.ToString("dd MMM yy")
                                                      <i class="bi bi-arrow-right-short"></i>
                                                      @act_.ActivityEndDate.ToString("dd MMM yy")
                                                    </span>                                           
                                                </td>

                                                @* Activity Durarion *@
