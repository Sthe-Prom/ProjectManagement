                                                                  <li class="align-middle ps-4 pe-4 pt-1" style="margin:0;padding:0;display: inline-flex; align-items: center;" disabled>
                                                                    <span class="" style="color: grey !important;" >
                                                                        <i class="bi bi-trash3"></i>
                                                                    </span>
                                                                  </li>
                                                              }

                                                          }
                                                      </ul>
                                                    </div>

                                                  </div>

                                                  @* Side *@
                                                  <div id="flush-collapse_@proj.Id" style="color:#0f204b;background-color:#e7f1ff;" class="accordion-collapse collapse mt-2" data-bs-parent="#accordionFlush">
                                                    <div class="accordion-body" >
                                                          <div class="d-flex flex-row justify-content-center">
                                                            <div class="col-sm-3 ps-3 pe-3" style="border-right:1px solid grey;color:#a71930;">
                                                              <h6 class="fw-semibold mb-1" style="color:#a71930;">Project Details</h6>
                                                              <p class="fw-light" style="color:#000;">@proj.ProjectDetails</p>
