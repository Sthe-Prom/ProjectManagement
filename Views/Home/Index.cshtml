@if(Model.Accounts.Where(c => c.Id == userId).FirstOrDefault() != null)
{  
        var all_pojects = from p in Model.Projects
                        join acc in Model.Accounts
                        on p.AccountID equals acc.AccountID
                        //where acc.Id == userId
                    select new {
                      AccountID = p.AccountID,
                      UserID = acc.Id,
                      ProjectID = p.Id,
                      SelectedAssignedUserIds = p.SelectedAssignedUserIds
                    };
      
        var project_lists = new List<int>();
        var activity_lists = new List<int>();    
      
        var currentUser = Model.Accounts.Where(c => c.Id == userId).FirstOrDefault(); 

        foreach(var itemId in all_pojects)
        {
            bool isUserAssigned = itemId.SelectedAssignedUserIds.Skip(1).Contains(currentUser.AccountID);

            if(isUserAssigned)
            {
              project_lists.Add(itemId.ProjectID);
            }
        }

        var projects_data = from acc in Model.Accounts
                      join proj in Model.Projects
                      on acc.AccountID equals proj.AccountID
                      join stat in Model.Statuses
                      on proj.ProjectStatusID equals stat.Id
                      join p_type in Model.ProjectTypes 
                      on proj.ProjectTypeID equals p_type.Id 
                      join kpi in Model.KPIs
                      on proj.ProjectKPI equals kpi.Id into gj
                      from kpi in gj.DefaultIfEmpty()
                      where acc.Id == userId ||
                                        //acc.AccountID == proj.SelectedAssignedUserIds[0]
                      (project_lists.Contains(proj.Id))

                    select new {
                      proj.AccountID,
                      proj.Id,
                      proj.ProjectName,
