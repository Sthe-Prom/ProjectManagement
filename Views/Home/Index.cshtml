                            <th class="text-warning text-center">Status</th>    
                            <th class="text-primary text-center">Activities</th>    
                        </tr>
                        
                    </thead>
                    <tbody>           
                        @{
                          
                          foreach(var proj in projects_data)
                          {
                            
                          
                            var tot_act = activities_data.Where(c => c.ProjectID == proj.Id).Count();

                            var getTTCompletion = @proj.ProjectEndDate - @proj.ProjectStartDate;

                            // Option A: Using TimeSpan properties (most common and readable)
                            int totalDays = getTTCompletion.Days;
                            int totalWeeks = totalDays / 7;
                            int remainingDays = totalDays % 7;

                            int hours = getTTCompletion.Hours;
                            int minutes = getTTCompletion.Minutes;
                            int seconds = getTTCompletion.Seconds;

                            var getProjectMembers = "";

                            if (proj.SelectedAssignedUserIds.Count() > 0)
                            {
                                // 2. Split the string by comma
                                                      
                                // 3. Parse each string part into an integer and add to the list
                                foreach (var member in proj.SelectedAssignedUserIds)
                                {                           
                                    var name = Model.Accounts.FirstOrDefault(c => c.AccountID == member);
                                    getProjectMembers += ", " + name.FirstName ;                       
                                    
                                }               
                            }
                            else
                            {
                                // No users were selected or the input was empty
                                var project_owner = Model.Accounts.Where(c => c.Id == userId).FirstOrDefault();
                                getProjectMembers = project_owner.FirstName;
                            }

                            <tr>
                                <td class="align-middle">@proj.ProjectName</td>
                                <td class="align-middle">
                                    <span>
                                      @proj.ProjectDetails
                                    </span>
                                </td>
                                <td class="align-middle">@proj.ProjectAreaOfWork</td>

                                @* Project Durarion *@
                                <td class="align-middle">@getProjectMembers.Substring(1)</td>

                                @* Project Durarion *@
                                <td class="align-middle text-center">
                                  <small class="text-muted" > <span style="font-size:11px;"> Days </span></small><span class="badge bg-light fs-7" style="color:#0F204B;">@totalDays</span> | <small class="text-muted"><span class="badge bg-light fs-7" style="color:#0F204B;">@totalWeeks</span><span style="font-size:11px;"> Weeks </span></small> 
                                </td>

                                @* Project Status *@
                                <td class="align-middle text-center">
                                  @if(proj.StatusName == "Started")
                                  {
                                      <span class="badge rounded-pill bg-primary"> @proj.StatusName</span>
                                  }
                                  else
                                  @if(proj.StatusName == "Upcoming")
                                  {
                                      <span class="badge rounded-pill bg-light text-muted"> @proj.StatusName</span>
                                  }
                                  else
                                  @if(proj.StatusName == "Ongoing")
                                  {
                                      <span class="badge rounded-pill bg-info"> @proj.StatusName</span>
                                  }
                                  else
                                  @if(proj.StatusName == "Completed")
                                  {
                                      <span class="badge rounded-pill bg-success"> @proj.StatusName</span>
                                  }
                                  else
                                  @if(proj.StatusName == "Incomplete")
                                  {
                                      <span class="badge rounded-pill bg-danger"> @proj.StatusName</span>
                                  }
                                  else
                                  @if(proj.StatusName == "On-Hold")
                                  {
                                      <span class="badge rounded-pill bg-secondary text-muted"> @proj.StatusName</span>
                                  }
                                  else
                                  @if(proj.StatusName == "Sent for Review")
                                  {
                                      <span class="badge rounded-pill bg-warning"> @proj.StatusName</span>
                                  }
                                
                                </td>

                                @* Activity Count *@
                                <td class="text-center align-middle">
                                  <ul class="list-unstyled d-flex" style="margin: 0 !important; padding: 0 !important;">
                                    <li class="align-middle" >
                                      @* <i class="bi bi-2-circle fs-5"></i> *@
