                                                          <a href="javascript:void(0)" id="cancelUpdateActivity_@act.Id" class="btn btn-sm btn-secondary">Cancel</a>                                                
                                                    </div>
                                                  </form>
                                                    

                                              </div>
                                                
                                          }

                                        }
                                        else
