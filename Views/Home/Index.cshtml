                                                  //var act2 = Model.Activities.Where(c => c.ProjectID == act.ProjectID).FirstOrDefault();
                                                  //var proj2 = Model.Projects.Where(c => c.Id == act2.ProjectID & c.AccountID != currentUser.AccountID).FirstOrDefault();
                                                  //var b = new List<int>{8,9,10};

