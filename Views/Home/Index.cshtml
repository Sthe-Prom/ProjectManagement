          const nameField = document.getElementById("ProjectModel_ProjectName");
          const nameCount = document.getElementById("charCountName");
          nameField.addEventListener("input", () => {
              nameCount.textContent = nameField.value.length;
          });

          // Project Details
          const detailsField = document.getElementById("ProjectModel_ProjectDetails");
          const detailsCount = document.getElementById("charCountDetails");
          detailsField.addEventListener("input", () => {
              detailsCount.textContent = detailsField.value.length;
          });
      });

        //Client-Side Validation (Simple but Effective)
        document.getElementById("btnSaveProject").addEventListener("click", function () {

            let form = document.getElementById("frmAddProject");

            if (!form.checkValidity()) {
                form.reportValidity();
                return;
            }

            // proceed with your AJAX or submit logic here
        });


        //D and G
        const dropZone = document.getElementById("dropZone");
        const fileInput = document.getElementById("ProjectFiles");

        // --- Utils ---
        function highlight() {
          dropZone.classList.add("border-primary", "bg-white");
        }
        function unhighlight() {
          dropZone.classList.remove("border-primary", "bg-white");
        }
        function renderFiles(files) {
          if (!files || files.length === 0) {
            dropZone.innerHTML = `<p class="mb-1 text-muted">Drop files here or click to browse</p>`;
            return;
          }

          // Show one or many
          if (files.length === 1) {
            dropZone.innerHTML = `
              <p class="mb-1 text-success fw-bold">File attached</p>
              <small>${files[0].name}</small>
            `;
          } else {
            const items = [...files].map(f => `<li>${f.name}</li>`).join("");
            dropZone.innerHTML = `
              <p class="mb-1 text-success fw-bold">Files attached (${files.length})</p>
              <ul class="mb-0 small">${items}</ul>
            `;
          }
        }

        // --- Open file picker on click (and keyboard) ---
        dropZone.addEventListener("click", () => {
          // Clear first so picking the same file triggers `change`
          fileInput.value = "";
          fileInput.click();
        });

        dropZone.setAttribute("tabindex", "0"); // focusable for keyboard
        dropZone.addEventListener("keydown", (e) => {
          if (e.key === "Enter" || e.key === " ") {
            e.preventDefault();
            fileInput.value = "";
            fileInput.click();
          }
        });

        // --- When user manually selects files ---
        fileInput.addEventListener("change", (e) => {
          const files = e.target.files;
          renderFiles(files);
        });

        // --- Drag events ---
        ["dragenter", "dragover"].forEach(evt =>
          dropZone.addEventListener(evt, (e) => {
            e.preventDefault();
            e.stopPropagation();
            highlight();
          })
        );

        ["dragleave", "drop"].forEach(evt =>
          dropZone.addEventListener(evt, (e) => {
            e.preventDefault();
            e.stopPropagation();
            // For dragleave: avoid flicker by checking relatedTarget
            if (evt === "dragleave" && dropZone.contains(e.relatedTarget)) return;
            unhighlight();
          })
        );

        // --- Handle drop ---
        dropZone.addEventListener("drop", (e) => {
          if (e.dataTransfer.files && e.dataTransfer.files.length > 0) {
            // Assign dropped files to input for normal form submission / FormData
            fileInput.files = e.dataTransfer.files;
            renderFiles(e.dataTransfer.files);
            // Clear the DataTransfer to avoid duplicate events in some browsers
            e.dataTransfer.clearData();
          }
        });
        //*******************< End Drag and Drop >*********************//

      //Multi-Select - User Members
      document.addEventListener("DOMContentLoaded", function () {

          const select = document.getElementById("memberSelect");
          const pillContainer = document.getElementById("selectedPills");

          function renderPills() {
              pillContainer.innerHTML = "";

              Array.from(select.selectedOptions).forEach(opt => {
                  if (opt.value === "") return; // ignore placeholder

                  let pill = document.createElement("span");
                  pill.className = "badge bg-primary d-flex align-items-center px-2 py-1";

                  pill.innerHTML = `
                      ${opt.text}
                      <button type="button" class="btn-close btn-close-white ms-2" style="font-size: .6rem;"></button>
                  `;

                  pill.querySelector("button").addEventListener("click", () => {
                      opt.selected = false;
                      renderPills();
                  });

                  pillContainer.appendChild(pill);
              });
          }

          select.addEventListener("change", renderPills);
      });
      

