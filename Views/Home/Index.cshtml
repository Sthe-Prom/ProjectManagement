                          </h5>

                          <div class="col-sm table-responsive" style="margin:0;padding:0;">

                            <input type="text" style="width:100%" id="searchInput" onkeyup="searchProAct()" placeholder="Search..." aria-label="Search" >

                            <table id="projectsTable" class="table table-striped table-bordered align-middle " style="margin:0;padding:0;">

                                <thead >
                                    <tr class="">
                                        <th rowspan="1" class="header text-center align-middle text-align:center">Activity Name</th>
                                        <th rowspan="1" class="header text-center align-middle text-align:center">Comments</th>
                                        <th rowspan="1" class="header text-center align-middle text-align:center">Challenges</th>
                                        <th rowspan="1" class="header text-center align-middle text-align:center">Start Date</th>
                                        <th rowspan="1" class="header text-center align-middle text-align:center">Activity Duration</th>
                                        <th colspan="1" class="header text-center align-middle text-align:center">Progress Details</th>
                                        <th rowspan="1" class="header text-center align-middle text-align:center">Files</th>
                                    </tr>

                                </thead>
                                <tbody >
                                    @{
                                        var countProject = 0;

                                        foreach(var proj in projects_data_admin.OrderBy(p => p.ProjectStartDate))
                                        {
                                          countProject++;
                                          var tot_act = activities_data.Where(c => c.ProjectID == proj.Id).Count();

                                          var getTTCompletion = @proj.ProjectEndDate - @proj.ProjectStartDate;

                                          // Option A: Using TimeSpan properties (most common and readable)
                                          int totalDays = getTTCompletion.Days;
                                          int totalWeeks = totalDays / 7;
                                          int totalMonths = totalDays / 30;
                                          int remainingDays = totalDays % 7;

                                          int hours = getTTCompletion.Hours;
                                          int minutes = getTTCompletion.Minutes;
                                          int seconds = getTTCompletion.Seconds;

                                          var getProjectMembers = "";

                                          if (proj.SelectedAssignedUserIds.Count() > 0)
                                          {
                                              // 2. Split the string by comma

                                              // 3. Parse each string part into an integer and add to the list
                                              foreach (var member in proj.SelectedAssignedUserIds)
                                              {
                                                  var name = Model.Accounts.FirstOrDefault(c => c.AccountID == member);
                                                  getProjectMembers += ", " + name.FirstName ;

                                              }
                                          }
                                          else
                                          {
                                              // No users were selected or the input was empty
                                              var project_owner = Model.Accounts.Where(c => c.Id == userId).FirstOrDefault();
                                              getProjectMembers = project_owner.FirstName;
                                          }

                                          @* HEADER - PROJECT *@
                                          <tr class="">

                                              <td colspan="100%" style="background-color:#0F204B;opacity:0.8;color:#fff;" >

                                                  <div class="align-middle accordion accordion-flush" id="accordionFlush" style="background-color: transparent !important;background: none !important;">
                                                    <div class="accordion-item" style="background-color:#0F204B;opacity:0.8;color:#fff;">

                                                      @* Main *@
                                                      <div class="d-flex flex-row justify-content-between ufs_container">

                                                        @* Project Name *@
                                                        <div class="col-sm-6" >
                                                            <span class="accordion-button collapsed fw-semibold" data-bs-toggle="collapse" data-bs-target="#flush-collapse_@proj.Id" aria-expanded="false" aria-controls="flush-collapse_@proj.Id">
                                                              <span class="fw-bold">@countProject. &nbsp;</span>@proj.ProjectName
                                                            </span>
                                                        </div>

                                                        @* Project Members *@
                                                        <div class="col-sm-2 d-none d-lg-block" style="background-color:#3D4A6B;border:1px solid grey;border-radius:4px;vertical-align:middle;width:110px;">

                                                            <span class="ps-2 pe-2" style="display: inline-flex; align-items: center;">
                                                                <i class="bi bi-people-fill fs-6"></i>
                                                                <span style="margin-left: 0.30rem;font-weight:100">@proj.SelectedAssignedUserIds.Count() Members</span>
                                                            </span>

                                                        </div>

                                                        @* Project Duration *@
                                                        <div class="col-sm-2 d-none d-lg-block" style="background-color:#3D4A6B;border:1px solid grey;border-radius:4px;vertical-align:middle;width:110px;">
                                                          @if(totalDays <= 0)
                                                          {
                                                            <span class="ps-3" style="display: inline-flex; align-items: center;">
                                                                <i class="bi bi-clock-history fs-6"></i>
                                                                <span style="margin-left: 0.30rem;font-weight:100">1 Day</span>
                                                            </span>
                                                          }else
