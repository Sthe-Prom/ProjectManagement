                                                                      <i class="bi bi-paperclip fs-5"></i>
                                                                    </span>
                                                                    @proj.ProjectFiles.Substring(4)
                                                                  </a>
                                                                </p>
                                                              }
                                                              else
                                                              {
                                                                <p class="fw-light">No project files</p>
                                                              }

                                                            </div>

                                                          </div>
                                                      </div>
                                                    </div>

                                                  </div>
                                                </div>

                                          </td>

                                      </tr>

                                      var countActivity = 0;
                                      foreach(var act in activities_data
                                              .Where(a => a.ProjectID == proj.Id)
                                              .OrderBy(a => a.ActivityStartDate))
                                      {
                                          countActivity++;
                                          @* ACTIVITIES *@
                                          <tr>

                                          @{
                                              var act_style = "";

                                              // Activity Style
                                              if(proj.AccountID == currentUser.AccountID && proj.Id != act.MemberProject) //Project Owner Actions
                                              {
