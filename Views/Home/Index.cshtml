                                                                <i class="bi bi-clock-history fs-6"></i>
                                                                <span style="margin-left: 0.30rem;font-weight:100">@totalWeeks Weeks</span>
                                                              </span>

                                                            }
                                                            else
                                                              if(totalWeeks > 4 )
                                                              {
                                                                  <span class="ps-3" style="display: inline-flex; align-items: center;">
                                                                    <i class="bi bi-clock-history fs-6"></i>
                                                                    <span style="margin-left: 0.30rem;font-weight:100">@totalMonths Month</span>
                                                                  </span>
                                                              }

