@* Table *@
@{
      var projects_data = from acc in Model.Accounts
                    join proj in Model.Projects
                    on acc.AccountID equals proj.AccountID
                    join stat in Model.Statuses
                    on proj.ProjectStatusID equals stat.Id
                    where acc.Id == userId
                  select new {
                    proj.AccountID,
                    proj.Id,
                    proj.ProjectName,
                    proj.ProjectDetails,
                    proj.ProjectAreaOfWork,
                    proj.ProjectStartDate,
                    proj.ProjectEndDate,
                    proj.ProjectWorkInConj,
                    proj.ProjectStatusID,
                    proj.ProjectFiles,
                    stat.StatusName,
                    proj.SelectedAssignedUserIds
                  };

      var activities_data = from proj in Model.Projects 
                        join act in Model.Activities
                        on proj.Id equals act.ProjectID
                        group new { proj, act }
                          by new { act.Id, act.ProjectID, act.ActivityName, act.ActivityComments,
                                act.ActivityChallenges, act.ActivityHighlights, act.ProjectFiles, 
                                act.ActivityProgress, act.ActivityUpdateTime, act.ActivityStartDate, act.ActivityEndDate }
                        into g
                        select new {
                            Id = g.Key.Id,
                            ProjectID = g.Key.ProjectID,
                            ActivityName = g.Key.ActivityName,
                            ActivityComments = g.Key.ActivityComments,
                            ActivityChallenges = g.Key.ActivityChallenges,
                            ActivityHighlights = g.Key.ActivityHighlights,
                            ActivityStartDate = g.Key.ActivityStartDate,
                            ActivityEndDate = g.Key.ActivityEndDate,
                            ActivityProgress = g.Key.ActivityProgress,
                            ActivityUpdateTime = g.Key.ActivityUpdateTime,      
                            ProjectFiles = g.Key.ProjectFiles,                            
                            totalActivities = g.Count()
                        };
}

@* <h4 class="text-center p-3" style="color: #A71930; font-weight: 300;">Manage Projects and Activities</h4> *@

@if(signInManager.IsSignedIn(User))                                               
{
   @if(await userManager.IsInRoleAsync(user,"Admin"))
    {
        <p>Admin is logged in</p>
    }
    else
    {
        <div class="container-fluid" style="margin-top: 20px;background-color: #fafafa; border: 1px lightgray solid; border-radius: 4px;">
          <div class="row">
              <div class="col-sm table-responsive">
              
                <table id="mir_projects" class="table table-striped table-bordered align-middle">
            
                    <thead>
                        <tr>                    
                            <th rowspan="2" class="text-center align-middle text-align:center">Project Name</th>
                            <th rowspan="2" class="text-center align-middle text-align:center">Project Details</th>
                            <th rowspan="2" class="text-center align-middle text-align:center">Area of Work</th>
                            <th rowspan="2" class="text-center align-middle text-align:center">Project Members</th>
                            <th rowspan="2" class="text-center align-middle text-align:center">Project Duration</th>
                            <th colspan="2" class="text-center align-middle text-align:center">Progress Details</th>                
                            <th rowspan="2" class="text-center align-middle text-align:center">Files</th>
                            <th rowspan="2" class="text-danger text-center align-middle">Action</th>
                        </tr>
