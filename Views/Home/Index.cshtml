                                processData: false,
                                cache: false,
                                data: formData_act,
                                success: activityUpdateSuccess,
                                error: activityUpdateError
                            });
                        }


                    });
           
                    function activityUpdateError(response){
                      if(response.responseCode == 1){
                        alert("An error occured while updating your Activity. please try again." + '\n' + response.responseMessage)
                      }
                    }

                    function activityUpdateSuccess(response) {
                        if (response.responseCode == 0) {

                            ActivityUpdate("Update Activity", "Activity Name: " + response.responseMessage
                                + " was updated successfully.");
                            //alert("Activity Added Successfully.");
                        }
                        else {
                            alert(response.responseMessage);
                        }
                    }

                    //DELETE Activity
                    $("#btnDeleteActivity_"+num_extr[0]).on("click", function() {

                            swal({
                                title: "Are you sure?",
                                text: "Activities deleted cannot be recovered",
                                type: "warning",
                                showCancelButton: true,
                                confirmButtonColor: "#DD6B55",
                                confirmButtonText: "Yes, delete Activity!",
                                cancelButtonText: "No, cancel!",
                                closeOnConfirm: false,
                                closeOnCancel: false
                                },
                                function (isConfirm) {
                                    if (isConfirm) {
                                           $.ajax({
                                                type: 'DELETE',
                                                url: '@Url.Action("DeleteActivity", "Home")' +'/' + num_extr[0],
                                                cache: false

                                            });

                                            swal({
                                                title: "Deleted",
                                                text: "Selected Activity has been deleted.",
                                                type: "success",
                                                confirmButtonColor: "#0F204B",
                                                confirmButtonText: "Okay",
                                                closeOnConfirm: false,
                                                html: true
                                            },
                                              function(){
                                                    location.reload();
                                                });


                                    } else {
                                        swal("Cancelled", "No Activities Deleted:)", "error");
                                    }
                                });

                    });

                };

        });

        //Table Functions

        //Search()
        function searchProAct() {
          // Declare variables
          var input, filter, table, tr, td, i, txtValue;
          input = document.getElementById("searchInput");
          filter = input.value.toUpperCase();
          table = document.getElementById("projectsTable");
          tr = table.getElementsByTagName("tr");

          // Loop through all table rows, and hide those who don't match the search query
          for (i = 0; i < tr.length; i++) {
            td = tr[i].getElementsByTagName("td")[0];
            if (td) {
              txtValue = td.textContent || td.innerText;
              if (txtValue.toUpperCase().indexOf(filter) > -1) {
                tr[i].style.display = "";
              } else {
                tr[i].style.display = "none";
              }
            }
          }
        }

    </script>

}

