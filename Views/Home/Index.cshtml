                                                          var today_ = DateTime.UtcNow.Date;
                                                          var seven_days = DateTime.UtcNow.AddDays(7);
                                                          overdue = activities_data.Where(x => x.ActivityProgress != 4 && x.ActivityProgress != 5 && x.ActivityEndDate < today_).ToList(); //Activity not completed and past dueDate
                                                          due_soon = activities_data.Where(x => x.ActivityProgress != 4 && x.ActivityEndDate > today_ && x.ActivityEndDate < seven_days).ToList();

                                                      }

                                                  }

