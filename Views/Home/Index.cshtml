                                                      @* EDIT *@
                                                      <li class="align-middle" data-bs-toggle="modal" data-bs-target="#btnEditActivity_@act.Id" >
                                                        <span class="safe">
                                                            <i class="bi bi-pencil-square"></i>
                                                        </span>
                                                      </li>

