 @section Scripts{
    <script>
        
        $(document).ready(function() {

                //Save Project
                $("#btnSaveProject").on("click", function() {
                              
                    var formData = new FormData(frmAddProject);
                    const values = [...formData.entries()];
                    const user_ids = formData.getAll('ProjectModel.SelectedAssignedUserIds');

                    var s_user_ids = '';
                    for (const id of user_ids) {
                      s_user_ids += ',' + id;
                    }

                    formData.append("ProjectModel_ProjectName", $("#ProjectModel_ProjectName").val() );
                    formData.append("ProjectModel_ProjectDetails",  $("#ProjectModel_ProjectDetails").val() );
                    formData.append("ProjectModel_ProjectAreaOfWork",  $("#ProjectModel_ProjectAreaOfWork").val() );
                    formData.append("ProjectModel_ProjectWorkInConj",  $("#ProjectModel_ProjectWorkInConj").val() );
                    formData.append("ProjectModel_SelectedAssignedUserIds", user_ids);
                    formData.append("ProjectModel_ProjectStartDate",  $("#ProjectModel_ProjectStartDate").val() ) ;
                    formData.append("ProjectModel_ProjectEndDate",  $("#ProjectModel_ProjectEndDate").val() ) ;
                    formData.append("ProjectModel_ProjectStatusID", $("#ProjectModel_ProjectStatusID").val() );
                    formData.append("ProjectModel_AccountID",  $("#ProjectModel_AccountID").val() );
                    formData.append("ProjectFiles",  $("#ProjectFiles").val() );

                    var f = [];
                    var s = 'The following fields are required: \n------------------------------\n';
                 
                    for(i = 0; i < values.length;i++){
                      if(values[i][1] === "" || values[i][1] === 0)// || values[i][1].name == "")
                      {
                        if(values[i][0].includes('.')){
                            s += values[i][0].split('.')[1] + '\n';
                            f.push(values[i][1]);
                          }else{
                            s += values[i][0] + '\n';
                            f.push(values[i][1]);
                          }
                        
                      }
                    }

                    if(f.length > 0){
                        //validateAddRoadFactorsForm();
                        alert(s);
                        //validatedNew();
                    }
                    else{
                                                                             
                      $.ajax({
                          type: 'POST',
                          url: '@Url.Action("AddProjectAjax", "Home")',
                          contentType: false,
                          processData: false,
                          cache: false,
                          data: formData,
                          success: projectAddSuccess,
                          error: projectAddError
                      });

                    }
                

                });

                function projectAddError(response) {
                    alert(response.ResponseMessage);
                }

                function projectAddSuccess(response) {
                    if (response.responseCode == 0) {
                        
                        ProjectAdd("Add Project", "Project Name: " + response.responseMessage 
                          + " was added successfully."); 
                        //alert("Project Added Successfully");                       
                    }
                    else {
                        alert(response.ResponseMessage);
                    }
                }  

                //Edit Project Forms
                const editProjectForms = document.getElementsByClassName("frmEditProject");

                for (const form of editProjectForms) {

                    const id = form.getAttribute("id");   
                
                    // Using match with regEx
                    let num_extr = id.match(/(\d+)/);
                    
                    // Display output if number extracted
                    if (num_extr) {
                        console.log('number found:' + num_extr[0]);
                    }                                

                    //UPDATE Project
                    $("#btnUpdateProject_"+num_extr[0]).on("click", function() {
                       
                        //var act_id = document.getElementById('projectId_1');
                        //console.log('delete key is:' + num_extr[0]);
                        
                        var formData = new FormData(form);
                        const values = [...formData.entries()];

                        const user_ids = formData.getAll('proj.SelectedAssignedUserIds');

                        var s_user_ids = '';
                        for (const id of user_ids) {
                          s_user_ids += ',' + id;
                        }

                       
                       // formData.append("ProjectModel_Id", $("#projectID").val() );
                        formData.append("proj_AccountID",  values[1][1] );
                        formData.append("proj_ProjectName", values[2][1] );
                        formData.append("proj_ProjectDetails",  values[3][1] );
                        formData.append("proj_ProjectAreaOfWork",  values[4][1] );
                        formData.append("proj_ProjectWorkInConj",  values[5][1] );
                        formData.append("proj_SelectedAssignedUserIds", s_user_ids );
                        formData.append("proj_ProjectStartDate",  formData.get('proj.ProjectStartDate') ) ;
                        formData.append("proj_ProjectEndDate",  formData.get('proj.ProjectEndDate') ) ;
                        formData.append("proj_ProjectStatusID", formData.get('proj.ProjectStatusID') );
                        formData.append("ProjectFiles",  formData.get('ProjectFiles') );
                       
                        var f = [];
                        var s = 'Please correct the following: \n---------------------------------\n';
                    
                        for(i = 0; i < values.length;i++){
                          if(values[i][1] === "" || values[i][1] === 0)// || values[i][1].name == "")
                          {
                            if(values[i][0].includes('.')){
                                s += values[i][0].split('.')[1] + '\n';
                                f.push(values[i][1]);
                              }else{
                                s += values[i][0] + '\n';
                                f.push(values[i][1]);
                              }
                            
                          }
                        }

                        if(f.length > 0){
                            //validateAddRoadFactorsForm();
                            alert(s);
                            //validatedNew();
                        }else{

                          $.ajax({
                              type: 'POST',
                              url: '@Url.Action("UpdateProject", "Home")' +'/' + num_extr[0],                       
                              contentType: false,
                              processData: false,
                              cache: false,
                              data: formData,
                              success: projectUpdateSuccess,
                              error: projectUpdateError
                          });       

                        }

                    });

                    function projectUpdateError(response) {
                        alert("error");
                    }

                    function projectUpdateSuccess(response) {
                        if (response.responseCode == 0) {
                            
                            ProjectEdit("Update Project", "Project Name: " + response.responseMessage 
                                + " was added successfully."); 
                            //alert("success");                
                        }
                        else {
                            alert('Error..');
                        }
                    }  

                };  

                //----------------- Activity --------------------

                //Activity Forms
                const addActivityForms = document.getElementsByClassName("frm_Activity");

                for (const form of addActivityForms) {

                    const id = form.getAttribute("id");   
                
                    // Using match with regEx
                    let num_extr = id.match(/(\d+)/);
                    
                    // Display output if number extracted
                    if (num_extr) {
                        console.log('number found:' + num_extr[0]);
                    }                                      
                                    
                    //SAVE Activity
                    $("#btnSaveActivity_"+num_extr[0]).on("click", function() {
                    
                        console.log("btnSaveActivity_"+num_extr[0] +" was clicked, but didn;t respond!");
                        
                        var formData_act = new FormData(form);
                        const values = [...formData_act.entries()];

                        formData_act.append("ActivityModel_ActivityName",  values[1][1] );
                        formData_act.append("ActivityModel_ActivityComments", values[2][1] );
                        formData_act.append("ActivityModel_ActivityChallenges", values[3][1] );
                        formData_act.append("ActivityModel_ActivityHighlights", values[4][1] );
                        formData_act.append("ActivityModel_ActivityStartDate", values[5][1] );
                        formData_act.append("ActivityModel_ActivityEndDate", values[7][1] );
                        formData_act.append("ActivityModel_ActivityProgress", values[9][1] );
                        formData_act.append("ActivityModel_ProjectID", values[0][1] );
                        formData_act.append("ProjectFiles",  values[10][1] );

                        var f = [];
                        var s = 'The following fields are required: \n------------------------------\n';
                    
                        for(i = 0; i < values.length;i++){
                                                    
                            if(values[i][1] === "" || values[i][1] === 0 ) //|| values[i][1].name == "")
                            {
                              if(values[i][0].includes('.')){
                                  if(values[i][0] !== "ActivityModel.ActivityComments" && values[i][0] !== "ActivityModel.ActivityChallenges" && values[i][0] !== "ActivityModel.ActivityHighlights"){
                                    s += values[i][0].split('.')[1] + '\n';
                                    f.push(values[i][1]);
                                  }
                                }else{
                                  s += values[i][0] + '\n';
                                  f.push(values[i][1]);
                                }                            
                            }

                          //}
                        }

                        if(f.length > 0){
                            //validateAddRoadFactorsForm();
                            alert(s);
                            //validatedNew();
                        }
                        else{
                           
                            $.ajax({
                                type: 'POST',
                                url: '@Url.Action("AddActivityAjax", "Home")',
                                contentType: false,
                                processData: false,
                                cache: false,
                                data: formData_act,
                                success: activitySuccess,
                                error: activityError
                            });    
                        }

                                
                    });               
                                
                    function activityError() {
                        alert("An error while adding your Action. please try again.");
                    }

                    function activitySuccess(response) {
                        if (response.responseCode == 0) {
                            
                            ActivityAdd("Add Activity", "Activity Name: " + response.responseMessage 
                                + " was added successfully.");   
                            //alert("Activity Added Successfully.");                     
                        }
                        else {
                            alert(response.ResponseMessage);
                        }
                    }

                    //DELETE Project
                    $("#btnDeleteProject_"+num_extr[0]).on("click", function() {
                      
                            swal({
                                title: "Are you sure?",
                                text: "Projects deleted cannot be recovered",
                                type: "warning",
                                showCancelButton: true,
                                confirmButtonColor: "#DD6B55",
                                confirmButtonText: "Yes, delete Project!",
                                cancelButtonText: "No, cancel!",
                                closeOnConfirm: false,
                                closeOnCancel: false
                                },
                                function (isConfirm) {
                                    if (isConfirm) {
                                           $.ajax({
                                                type: 'DELETE',
                                                url: '@Url.Action("DeleteProject", "Home")' +'/' + num_extr[0],                       
                                                cache: false
                                                
                                            });                                              
                              
                                            swal({
                                                title: "Deleted",
                                                text: "Selected Project has been deleted.",
                                                type: "success",
                                                confirmButtonColor: "#0F204B",
                                                confirmButtonText: "Okay",
                                                closeOnConfirm: false,
                                                html: true                                                  
                                            },
                                              function(){ 
                                                    location.reload();
                                                }); 
                                            

                                    } else {
                                        swal("Cancelled", "No Projects Deleted:)", "error");
                                    }
                                });  
                            
                    });
                   
                };

                //Activity (All) (Edit + Delete) Forms
                const allActivityForms = document.getElementsByClassName("act_form");

                for (const form of allActivityForms) {

                    const id = form.getAttribute("id");   
                
                    // Using match with regEx
                    let num_extr = id.match(/(\d+)/);
                                                            
                    $("#btnEditActivity_"+num_extr[0]).click(function() {                                     
                        $('#card_edit_'+num_extr[0]).toggle(); 
                        //$('#card_view_'+num_extr[0]).toggle();                                           
                    });  

                    $("#cancelUpdateActivity_"+num_extr[0]).click(function() {                                     
                        $('#card_edit_'+num_extr[0]).toggle(); 
                        //$('#card_view_'+num_extr[0]).toggle();                                           
                    });  

                     //UPDATE Activity
                    $("#btnUpdateActivity_"+num_extr[0]).on("click", function() {
                    
                        var formData_act = new FormData(form);
                        const values = [...formData_act.entries()];

                        formData_act.append("act_ActivityName",  values[1][1] );
                        formData_act.append("act_ActivityComments", values[2][1] );
                        formData_act.append("act_ActivityChallenges", values[3][1] );
                        formData_act.append("act_ActivityHighlights", values[4][1] );
                        formData_act.append("act_ActivityStartDate", values[5][1] );
                        formData_act.append("act_ActivityEndDate", values[7][1] );
                        formData_act.append("act_ActivityProgress", values[9][1] );
                        formData_act.append("ActivityModel_Id", values[0][1] );
                        formData_act.append("ProjectFiles",  values[10][1] );

                        var f = [];
                        var s = 'Please correct the following: \n---------------------------------\n';
                    
                        for(i = 0; i < values.length;i++){
                          if(values[i][1] === 0)// || values[i][1].name == "")
                          {
                            if(values[i][0].includes('.')){
                                if(values[i][0] !== "ActivityModel.ActivityComments" && values[i][0] !== "ActivityModel.ActivityChallenges" && values[i][0] !== "ActivityModel.ActivityHighlights"){
                                  s += values[i][0].split('.')[1] + '\n';
                                  f.push(values[i][1]);
                                }
                              }else{
                                s += values[i][0] + '\n';
                                f.push(values[i][1]);
                              }
                            
                          }
                        }

                        if(f.length > 0){
                            //validateAddRoadFactorsForm();
                            alert(s);
                            //validatedNew();
                        }
                        else{
                           
                            $.ajax({
                                type: 'POST',
                                url: '@Url.Action("UpdateActivity", "Home")',
                                contentType: false,
                                processData: false,
                                cache: false,
                                data: formData_act,
                                success: activityUpdateSuccess,
                                error: activityUpdateError
                            });    
                        }

                                
                    });               
                                
                    function activityUpdateError() {
                        alert("An error while updating your Activity. please try again.");
                    }

                    function activityUpdateSuccess(response) {
                        if (response.responseCode == 0) {
                            
                            ActivityUpdate("Update Activity", "Activity Name: " + response.responseMessage 
                                + " was updated successfully.");   
                            //alert("Activity Added Successfully.");                     
                        }
                        else {
                            alert(response.ResponseMessage);
                        }
                    }       
                    
                    //DELETE Activity
                    $("#btnDeleteActivity_"+num_extr[0]).on("click", function() {
                      
                            swal({
                                title: "Are you sure?",
                                text: "Activities deleted cannot be recovered",
                                type: "warning",
                                showCancelButton: true,
                                confirmButtonColor: "#DD6B55",
                                confirmButtonText: "Yes, delete Activity!",
                                cancelButtonText: "No, cancel!",
                                closeOnConfirm: false,
                                closeOnCancel: false
                                },
                                function (isConfirm) {
                                    if (isConfirm) {
                                           $.ajax({
                                                type: 'DELETE',
                                                url: '@Url.Action("DeleteActivity", "Home")' +'/' + num_extr[0],                       
                                                cache: false
                                                
                                            });                                              
                              
                                            swal({
                                                title: "Deleted",
                                                text: "Selected Activity has been deleted.",
                                                type: "success",
                                                confirmButtonColor: "#0F204B",
                                                confirmButtonText: "Okay",
                                                closeOnConfirm: false,
                                                html: true                                                  
                                            },
                                              function(){ 
                                                    location.reload();
                                                }); 
                                            

                                    } else {
                                        swal("Cancelled", "No Activities Deleted:)", "error");
                                    }
                                });  
                            
                    });                          

                   
                };
              

        });         

    </script>
}

