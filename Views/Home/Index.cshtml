                                                              <div class="d-flex flex-row justify-content-between">
                                                                <div class="col-auto"> 
                                                                  <p>Start Date</p>
                                                                  <p class="fw-bold">@proj.ProjectStartDate.ToString("MMM-d-yyyy")</p>
                                                                </div>
                                                                <div class="col-auto text-center"> 
                                                                    |
                                                                </div>
                                                                <div class="col-auto"> 
                                                                  <p>End Date</p>
                                                                  <p class="fw-bold">@proj.ProjectEndDate.ToString("MMM-d-yyyy")</p>
                                                                </div>
                                                              </div>
                                                            </div>
                                                            <div class="col-sm-2 ps-3 pe-3" style="border-right:1px solid grey;">
