                                                      <span>
                                                        @act.ActivityStartDate.ToString("dd MMM yy")
                                                        <i class="bi bi-arrow-right-short"></i>
                                                        @act.ActivityEndDate.ToString("dd MMM yy")
                                                      </span>                                                        
                                                  </td>

                                                   @* Activity Durarion *@
                                                  <td style="width:10%" class="align-middle text-center">
                                                    @*<small class="text-muted" >
                                                      <span style="font-size:11px;"> Days </span></small><span class="badge bg-light fs-7" style="color:#0F204B;">@totalDays</span> | <small class="text-muted"><span class="badge bg-light fs-7" style="color:#0F204B;">@totalWeeks</span><span style="font-size:11px;"> Weeks </span></small> *@

                                                      @{
                                                        var getTTCompletion_useract = act.ActivityEndDate - act.ActivityStartDate;

                                                        // Option A: Using TimeSpan properties (most common and readable)
                                                        int totalDays_useract = getTTCompletion_useract.Days;
                                                        int totalWeeks_useract = getTTCompletion_useract.Days / 7;
                                                        var duration_style = "";
                                                        var title_tag = "";
                                                                              
                                                      }

                                                      @if(due_soon.Any(x => x.Id == act.Id))
                                                      {
                                                          duration_style = "text-warning";
                                                          title_tag = "data-bs-toggle=\"tooltip\" data-bs-placement=\"top\" title=\"This activity is due soon.\"";
                                                      }

                                                      @if(overdue.Any(x => x.Id == act.Id))
                                                      {
                                                          duration_style = "text-danger";
                                                          title_tag = "data-bs-toggle=\"tooltip\" data-bs-placement=\"top\" title=\"This activity is overdue.\"";
                                                      }

                                                      @if(totalDays_useract <= 0)
                                                        {
                                                        <span class="ps-3 justify-content-between" style="display: inline-flex; align-items: center;width:80px;">
                                                            <i class="bi bi-clock-history fs-6 @duration_style" @Html.Raw(title_tag)></i>
                                                            <span style="margin-left: 0.30rem;font-weight:100">1 Day</span>
                                                        </span>
                                                        }else
                                                              if(totalDays_useract > 0 && totalDays_useract <= 7)
                                                              {
                                                              <span class="ps-3 justify-content-between" style="display: inline-flex; align-items: center;width:80px;">
                                                              
                                                                  <i class="bi bi-clock-history fs-6 @duration_style" @Html.Raw(title_tag)></i>
                                                            
                                                                  <span style="margin-left: 0.30rem;font-weight:100">@totalDays_useract Days</span>
                                                              </span>
                                                              }else
                                                                  if(totalDays_useract > 7 && totalWeeks_useract <= 5 )
                                                                  {

                                                                  <span class="ps-3 justify-content-between" style="display: inline-flex; align-items: center;width:80px;">
                                                                      <i class="bi bi-clock-history fs-6 @duration_style" @Html.Raw(title_tag)></i>
                                                                      <span style="margin-left: 0.30rem;font-weight:100">@totalWeeks_useract Wks</span>
                                                                  </span>

                                                                  }
                                                                  else
                                                                  if(totalWeeks_useract > 5 )
                                                                  {
                                                                      int months = 0;
                                                                      DateTime endDate = act.ActivityEndDate;
                                                                      DateTime startDate = act.ActivityStartDate;
                                                                      while(startDate < endDate)
                                                                      {
                                                                          DateTime checkDate = startDate.AddMonths(1);
                                                                          if(checkDate <= endDate)
                                                                          {
                                                                              months++;
                                                                              startDate = checkDate;
                                                                          }
                                                                          else
                                                                          {
                                                                              break;
                                                                          }
                                                                      }
                                                                      <span class="ps-3 justify-content-between" style="display: inline-flex; align-items: center;width:80px;">
                                                                          <i class="bi bi-clock-history fs-6 @duration_style" @Html.Raw(title_tag)></i>
                                                                          <span style="margin-left: 0.30rem;font-weight:100">@months Mnts</span>
                                                                      </span>
                                                                  }

                                                  </td>

