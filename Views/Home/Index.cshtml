                            <div class="modal modal-md fade" id="modalProjectEdit_@proj.Id" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1" aria-labelledby="staticBackdropLabel" aria-hidden="true">
                              <div class="modal-dialog">
                                    <form enctype="multipart/form-data" class="frmEditProject" id="frmEditProject_@proj.Id">
                                  
                                        <div class="modal-content">
                                          <div class="modal-header">
                                            <h1 class="modal-title fs-5" id="staticBackdropLabel">Update Project</h1>
                                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                          </div>
                                          <div class="modal-body">

                                              <input type="hidden" id="projectID" value="@proj.Id" asp-for="@Model.ProjectModel.Id" class="form-control" />
                                              
                                              <input type="hidden" asp-for="@proj.AccountID" class="form-control" />

                                              <div class="mb-3 form-group">
                                                  <label class="col-form-label fw-bold">Project Name:</label>
                                                  <input class="form-control" placeholder="Project Name" asp-for="@proj.ProjectName" />
                                              </div>

                                              <div class="mb-3 form-group">
                                                  <label class="col-form-label fw-bold">Project Details:</label>
                                                  <textarea class="form-control" placeholder="Project Details" style="margin-top:0 !important;" asp-for="@proj.ProjectDetails">
                                                      @proj.ProjectDetails
                                                  </textarea>
                                              </div>

                                              <div class="mb-3 form-group">
                                                  <label class="col-form-label fw-bold">Area of Work:</label>
                                                  <input type="text" placeholder="SAS, DHET, HR, Faculties, Snr Director, Rector, ect." asp-for="@proj.ProjectAreaOfWork" class="form-control"  />
                                              </div>

                                              <input type="hidden" asp-for="@proj.ProjectWorkInConj" value="null" class="form-control"  />
                                              
                                              <div class="mb-3 form-group">
                                                  <label asp-for="@proj.SelectedAssignedUserIds" class="col-form-label fw-bold">Project Members</label>                                        
                                                  <select class="form-select mb-3" size="3" asp-for="@proj.SelectedAssignedUserIds" asp-items="Model.UserAccounts" multiple required>
                                                      <option selected>Select Project Members</option>                                            
                                                  </select> 
                                              </div>

                                              <div class="row mb-3">
                                                  <div class="col-sm-6">
                                                      <label class="col-form-label fw-bold">Start Date</label>
                                                      <input type="date" asp-for="@proj.ProjectStartDate" class="form-control"  />
                                                  </div>

                                                  <div class="col-sm-6">
                                                      <label class="col-form-label fw-bold">End Date</label>
                                                      <input type="date" asp-for="@proj.ProjectEndDate" class="form-control"  />
                                                  </div>
                                              </div>

                                              <div class="form-group mb-3">
                                                  <label asp-for="@Model.ProjectModel.ProjectStatusID" class="col-form-label fw-bold">Project Progress</label>
                                            
                                                  <select class="form-select mb-3" asp-for="@proj.ProjectStatusID" asp-items="Model.StatusList" required>
                                                      <option value="" selected> @proj.StatusName</option>                                    
                                                  </select>

                                              </div>
                                          
                                              <div class="form-group mb-3">

                                                  <label class="col-form-label fw-bold" style="margin-bottom:0 !important;" >Project Attachments:</label>
                                                  <div class="custom-file">
                                                      <input type="file" class="form-control" asp-for="@Model.ProjectFiles"/>
                                                      @if(proj.ProjectFiles.Count() > 5)
                                                      {
                                                        <div class="ps-1">
                                                          <p>
                                                            Current document: <a href="~/Attachments/Projects/@proj.ProjectFiles" target="_blank">@proj.ProjectFiles.Substring(4)</a>
                                                            <br />
                                                            <span style="vertical-align:center;color:#A71930;">
                                                              <i class="bi bi-info-circle fs-6" ></i> To change, select a new file above.
                                                            </span>                                                           
                                                          </p>
                                                        </div>
                                                      }                                                                                                        
                                                      
                                                  </div>

                                              </div>
                                          </div>
                                          <div class="modal-footer">

                                            <div class="mt-2 col-sm-12">
                                                <a href="javascript:void(0)" id="btnUpdateProject_@proj.Id" class="btn btn-md btn-primary mb-1" style="background-color:#A71930;color:white;">Update Project</a>
                                                <a href="javascript:void(0)" id="cancelBut" data-bs-dismiss="modal" class="btn btn-md btn-secondary mb-1">Cancel</a>  
                                            </div>    

                                          </div>
                                        </div>

                                    </form>
                              </div>
                            </div>

                          }

                        }

                    </tbody>
                    @* <tfoot>
                        <tr>
                            <th>Project Name</th>
                            <th>Area of Work</th>
                            <th>Work in Conjunction</th>
                            <th>Days since started</th>
                            <th>Progress</th>
                            <th>Files attached</th>
                        </tr>
                    </tfoot> *@

                </table>

              </div>     
          </div>
        </div>        
    }


