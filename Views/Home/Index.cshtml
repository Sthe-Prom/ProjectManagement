                                              countActivity++;
                                              @* ACTIVITIES *@
                                              <tr>

                                                @* ActivityName *@
                                                <td class="align-middle">
                                                    <span>
                                                      <span class="fw-bold">@countActivity.</span> @act_.ActivityName
                                                    </span>
                                                </td>

                                                @* ActivityComments *@
                                                <td class="align-middle">
                                                    @act_.ActivityComments
                                                </td>

                                                @* Challenges *@
                                                <td class="align-middle">
                                                    @act_.ActivityChallenges
                                                </td>

                                                @* Activity Start Date *@
                                                <td class="align-middle text-center align-center">                                                                                                   
