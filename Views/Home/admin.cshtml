                                                  @if(act_.ActivityProgress == 2)
                                                  {
                                                      <span class="badge rounded-pill bg-primary">Started</span>
                                                  }
                                                  else
                                                  @if(act_.ActivityProgress == 1)
                                                  {
                                                      <span class="badge rounded-pill bg-light text-muted">Upcoming</span>
                                                  }
                                                  else
                                                  @if(act_.ActivityProgress == 3)
                                                  {
                                                      <span class="badge rounded-pill bg-info">Ongoing</span>
                                                  }
                                                  else
                                                  @if(act_.ActivityProgress == 4)
