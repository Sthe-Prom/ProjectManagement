 @* Admin Main *@
 @{/*
              <div id="main" class="main" style="margin-top:0 !important;">

                <div class="pagetitle" >

                    <div class="row gap-2 d-flex flex-row justify-content-center mt-1">
                      
                      <div class="col-sm-2 col-md-2 d-none d-sm-block align-content-center mt-1 mb-4" >
                          <h1>Dashboard</h1>
                          <nav>
                            <ol class="breadcrumb">
                              <li class="breadcrumb-item active">Projects/Activities Summaries </li>
                            </ol>
                          </nav>
                      </div>

                      @* Staff *@
                      <div class="col-sm rounded-2 align-content-center mt-1 mb-4" style="border:1px solid lightgrey;">
      
                            @if(!string.IsNullOrEmpty(Context.Request.Query["Staff"] ))
                            {
                              <li class="list-inline-item filter-active m-2 " style="font-size: 12px;color:white;background-color: #ececec;color:#0f204b !important;padding:4px 5px;border-radius:6px;border:1px solid #0f204b;">
                                                                    
                                    <svg xmlns="http://www.w3.org/2000/svg" class="pe-1" width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M12.6512 14.0654L11.6047 20H9.57389L10.9247 12.339L3.51465 4.92892L4.92886 3.51471L20.4852 19.0711L19.071 20.4853L12.6512 14.0654ZM11.7727 7.53009L12.0425 5.99999H10.2426L8.24257 3.99999H19.9999V5.99999H14.0733L13.4991 9.25652L11.7727 7.53009Z"></path></svg>
                                                                  
                                      @Html.ActionLink(
                                          "Clear Filter", 
                                          "Index", 
                                          new {Status = ViewBag.Status  }, 
                                          new { @class="clear_filter" }
                                      )                               
                                  
                              </li>
                            }

                          @{var AccountFilter = ViewBag.Staff;}

                          <li class="list-inline-item filter-active m-2" style="font-size: 12px;color:white;background-color: #ececec;color:#0f204b !important;padding:4px 5px;border-radius:6px;border:1px solid #0f204b;">
                            @if(AccountFilter != null)
                            {
                              <span style="vertical-align:middle;" >
                                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="#00D100"><path d="M7 3V6H3V8H7V11H9V3H7ZM11 8H21V6H11V8ZM17 13V16H21V18H17V21H15V13H17ZM13 18H3V16H13V18Z"></path></svg>
                              </span>  
                              <span class="apply_filter">Filters Applied</span>
                            }
                            else
                            {
                              <span style="vertical-align:middle;">
                                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="#969696"><path d="M7 3V6H3V8H7V11H9V3H7ZM11 8H21V6H11V8ZM17 13V16H21V18H17V21H15V13H17ZM13 18H3V16H13V18Z"></path></svg>
                              </span> 
                              <span class="no_apply_filter">No Filters</span>
                            }
                          </li>      

                          @{
                              var statusId = ViewBag.Status;

                              var StartDateStaff = ViewBag.StartDate;
                              var EndDateStaff = ViewBag.EndDate;
                            
                            }
                        
                          <select id="staff-filter"  class="form-select ms-2 mb-2 ">

                            <option value="" selected>Filter by Staff</option>
                        
                            @foreach(var account in Model.Accounts )
                            {                        
                                var selected = account.AccountID == (ViewBag.Staff) ? "selected" : "";   
                                var url = "";                                             
                                
                                @if(statusId != 0 || (StartDateStaff != null && EndDateStaff != null) )
                                {
                                  url = Url.Action( "Index", 
                                          new {Status = statusId, Staff = account.AccountID, StartDate = StartDateStaff, EndDateStaff = EndDateStaff })   ;  
                                  
                                  @:  <option value="@url" @selected>@account.FirstName   </option>                                  
                                
                                }
                                else
                                {
                                  url = Url.Action("Index", new { Staff = account.AccountID });                                    
                                  @: <option value="@url" @selected >  @account.FirstName </option>
                                  
                                }

                            }   

                          </select>                          

                      </div>

                      @* Status Filter *@
                      <div class="col-sm rounded-2 align-content-center mt-1 mb-4" style="border:1px solid lightgrey;">
                                            
                        @if(!string.IsNullOrEmpty(Context.Request.Query["Status"] ))
                        {
                          <li class="list-inline-item filter-active m-2" style="font-size: 12px;color:white;background-color: #ececec;color:#0f204b !important;padding:4px 5px;border-radius:6px;border:1px solid #0f204b;">
                            <svg xmlns="http://www.w3.org/2000/svg" class="pe-1" width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M12.6512 14.0654L11.6047 20H9.57389L10.9247 12.339L3.51465 4.92892L4.92886 3.51471L20.4852 19.0711L19.071 20.4853L12.6512 14.0654ZM11.7727 7.53009L12.0425 5.99999H10.2426L8.24257 3.99999H19.9999V5.99999H14.0733L13.4991 9.25652L11.7727 7.53009Z"></path></svg>
                                                            
                                @Html.ActionLink(
                                    "Clear Filter", 
                                    "Index", 
                                    new {Staff = ViewBag.Staff }, 
                                    new { @class="clear_filter" }
                                )                                    
                              
                          </li>
                        }

                          @{var StatusFilter = ViewBag.Status;}

                          <li class="list-inline-item filter-active m-2" style="font-size: 12px;color:white;background-color: #ececec;color:#0f204b !important;padding:4px 5px;border-radius:6px;border:1px solid #0f204b;">
                            
                            @if(StatusFilter != null)
                            {
                              <span style="vertical-align:middle;" class="pe-1">
                                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="#00D100"><path d="M7 3V6H3V8H7V11H9V3H7ZM11 8H21V6H11V8ZM17 13V16H21V18H17V21H15V13H17ZM13 18H3V16H13V18Z"></path></svg>
                              </span>
                              <span class="apply_filter">Filters Applied</span>
                            }
                            else
                            {
                              <span style="vertical-align:middle;" class="pe-1">
                                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="#969696"><path d="M7 3V6H3V8H7V11H9V3H7ZM11 8H21V6H11V8ZM17 13V16H21V18H17V21H15V13H17ZM13 18H3V16H13V18Z"></path></svg>
                              </span>
                              <span class="no_apply_filter">No Filters</span>
                            }
                          </li>
                          
                        
                          <select id="status-filter"  class="form-select ms-2 mb-2 ">

                            @{
                              var staffId = ViewBag.Staff;
                              
                              var StartDateStatus = ViewBag.StartDate;
                              var EndDateStatus = ViewBag.EndDate;
                            }
                            
                            <option value="" selected>Filter by Status</option>

                            @foreach(var status in Model.Statuses)
                            {
                              var selected = status.Id == (ViewBag.Status) ? "selected" : ""; 
                              var url = "";                                                               

                                  @if(staffId != 0 || (StartDateStatus != null && EndDateStatus != null) )
                                  {
                                    url = Url.Action("Index", new {Staff = staffId, Status = status.Id, StartDate = StartDateStatus, EndDate = EndDateStatus }); 
                                    @: <option value="@url" @selected>@status.StatusName </option>
                                  }
                                  else
                                  {
                                    url = Url.Action("Index", new { Status = status.Id });
                                    @: <option value="@url" @selected > @status.StatusName</option>
                                  }

                            }
                          </select>

                        
                      </div>

                      @* Date Filter *@
                      <div class="col-sm rounded-2 align-content-center mt-1 mb-4" style="border:1px solid lightgrey;">

                        @if((!string.IsNullOrEmpty(Context.Request.Query["StartDate"] )) && (!string.IsNullOrEmpty(Context.Request.Query["EndDate"] )) )
                        {
                            <li class="list-inline-item filter-active m-2" style="font-size: 12px;color:white;background-color: #ececec;color:#0f204b !important;padding:4px 5px;border-radius:6px;border:1px solid #0f204b;">
                              <svg xmlns="http://www.w3.org/2000/svg" class="pe-1" width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M12.6512 14.0654L11.6047 20H9.57389L10.9247 12.339L3.51465 4.92892L4.92886 3.51471L20.4852 19.0711L19.071 20.4853L12.6512 14.0654ZM11.7727 7.53009L12.0425 5.99999H10.2426L8.24257 3.99999H19.9999V5.99999H14.0733L13.4991 9.25652L11.7727 7.53009Z"></path></svg>

                                  @if(ViewBag.Staff != null && ViewBag.Status != null)
                                  {     
                                    @Html.ActionLink(
                                        "Clear Filter", 
                                        "Index", 
                                        new {Staff = ViewBag.Staff, Status = ViewBag.Status }, 
                                        new { @class="clear_filter" }
                                    )         
                                  }     
                                  else
                                  if(ViewBag.Staff != null)
                                  {
                                     @Html.ActionLink(
                                        "Clear Filter", 
                                        "Index", 
                                        new {Staff = ViewBag.Staff }, 
                                        new { @class="clear_filter" }
                                    ) 
                                  }   
                                  else
                                  if(ViewBag.Status != null)
                                  {
                                     @Html.ActionLink(
                                        "Clear Filter", 
                                        "Index", 
                                        new {Status = ViewBag.Status }, 
                                        new { @class="clear_filter" }
                                    ) 
                                  }                      
                                
                            </li>
                        }    

                          @{
                              var StartDate = ViewBag.StartDate;
                              var EndDate = ViewBag.EndDate;
                            }

                          <li class="list-inline-item filter-active mt-0 mb-2 ms-2" style="font-size: 12px;color:white;background-color: #ececec;color:#0f204b !important;padding:4px 5px;border-radius:6px;border:1px solid #0f204b;">
                            
                              @if(StartDate != null || EndDate != null)
                              {
                                <span style="vertical-align:middle;" class="pe-1">
                                  <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="#00D100"><path d="M7 3V6H3V8H7V11H9V3H7ZM11 8H21V6H11V8ZM17 13V16H21V18H17V21H15V13H17ZM13 18H3V16H13V18Z"></path></svg>
                                </span>
                                <span class="apply_filter">Filters Applied</span>
                              }
                              else
                              {
                                <span style="vertical-align:middle;" class="pe-1">
                                  <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="#969696"><path d="M7 3V6H3V8H7V11H9V3H7ZM11 8H21V6H11V8ZM17 13V16H21V18H17V21H15V13H17ZM13 18H3V16H13V18Z"></path></svg>
                                </span>
                                <span class="no_apply_filter">No Filters</span>
                              }

                          </li>            

                           @{
                              var StatusDate = ViewBag.Status;
                              var StaffDate = ViewBag.Staff;
                            }      
                         
                          <form method="get" class="d-flex align-items-center ms-1 me-1 pe-1 ps-1">

                              @if (StatusDate != null && StaffDate != null)
                              {
                                  <input type="hidden" name="Status" class="form-control" value="@Context.Request.Query["Status"]" />

                                  <input type="date" id="start_date" placeholder="Start Date" name="StartDate" class="form-control" value="@Context.Request.Query["StartDate"]" />

                                  <input type="date" id="end_date" placeholder="End Date" name="EndDate" class="form-control" value="@Context.Request.Query["EndDate"]" />
                      
                                  <input type="hidden" name="Staff" class="form-control" value="@Context.Request.Query["Staff"]" />
                                 
                              }
                              else
                              if(StatusDate != null)
                              {
                                  <input type="hidden" name="Status" class="form-control" value="@Context.Request.Query["Status"]" />

                                  <input type="date" id="start_date" placeholder="Start Date" name="StartDate" class="form-control" value="@Context.Request.Query["StartDate"]" />

                                  <input type="date" id="end_date" placeholder="End Date" name="EndDate" class="form-control" value="@Context.Request.Query["EndDate"]" />                      
                              }
                              else
                              if(StaffDate != null)
                              {
                                  <input type="hidden" name="Staff" class="form-control" value="@Context.Request.Query["Staff"]" />

                                  <input type="date" id="start_date" placeholder="Start Date" name="StartDate" class="form-control" value="@Context.Request.Query["StartDate"]" />

                                  <input type="date" id="end_date" placeholder="End Date" name="EndDate" class="form-control" value="@Context.Request.Query["EndDate"]" />
                              }
                              else
                              {
                                  <input type="date" id="start_date" name="StartDate" class="form-control" value="@Context.Request.Query["StartDate"]" />

                                  <input type="date" id="end_date" name="EndDate" class="form-control" value="@Context.Request.Query["EndDate"]" />
                              }

                              <button type="submit" class="btn btn-outline-secondary">
                                  <i class="bi bi-funnel-fill"></i>
                              </button>

                          </form>

                      </div>
                   
                    </div>

                </div>

                @* @*End Page Title *@

                <section class="section dashboard" style="margin-top:0;">
                  
                  <div class="row">

                    @*Left side columns *@
                    <div class="col-lg-8">
                      <div class="row">

                        @*Project Card *@
                        <div class="col-xxl-4 col-md-4">
                          <div class="card info-card sales-card">
                            <div class="filter">
                              <a class="icon" href="#" data-bs-toggle="dropdown">
                                <i class="bi bi-three-dots"></i>
                              </a>
                              <ul
                                class="dropdown-menu dropdown-menu-end dropdown-menu-arrow"
                              >
                                <li class="dropdown-header text-start">
                                  <h6>Filter</h6>
                                </li>

                                <li><a class="dropdown-item" href="#">Today</a></li>
                                <li><a class="dropdown-item" href="#">This Month</a></li>
                                <li><a class="dropdown-item" href="#">This Year</a></li>
                              </ul>
                            </div>

                            <div class="card-body">
                              <h5 class="card-title">Projects <span>| All</span></h5>

                              <div class="d-flex align-items-center">
                                <div
                                  class="card-icon rounded-circle d-flex align-items-center justify-content-center"
                                >
                                  <i class="bi bi-folder2"></i>
                                </div>
                                <div class="ps-3">
                                  <h6>
                                    @{
                                      var p = from p_ in Model.Projects
                                            select new {
                                              p_.Id
                                            };
                                    }
                                    @p.Count()
                                  </h6>
                                  <span class="text-primary small pt-1 fw-bold">
                                    @{
                                        var completed_proj = Model.Projects.Where(p => p.ProjectStatusID == 4).ToList();
                                        double getPerc_proj = 0;
                                        if(p.Count() > 0)
                                        {
                                          getPerc_proj = ((double)completed_proj.Count / p.Count()) *100;
                                        }
                                      }
                                      @getPerc_proj.ToString("F2")%
                                  </span>
                                  <span class="text-muted small pt-2 ps-1">Completed</span>
                                </div>
                              </div>
                            </div>
                          </div>
                        </div>
                        @*End Project Card *@

                        @*Activities Card *@
                        <div class="col-xxl-4 col-md-4">
                          <div class="card info-card revenue-card">
                            <div class="filter">
                              <a class="icon" href="#" data-bs-toggle="dropdown"
                                ><i class="bi bi-three-dots"></i></a>
                              <ul
                                class="dropdown-menu dropdown-menu-end dropdown-menu-arrow"
                              >
                                <li class="dropdown-header text-start">
                                  <h6>Filter</h6>
                                </li>

                                <li><a class="dropdown-item" href="#">Today</a></li>
                                <li><a class="dropdown-item" href="#">This Month</a></li>
                                <li><a class="dropdown-item" href="#">This Year</a></li>
                              </ul>
                            </div>

                            <div class="card-body">
                              <h5 class="card-title">
                                Activities <span>| All</span>
                              </h5>

                              <div class="d-flex align-items-center">
                                <div
                                  class="card-icon rounded-circle d-flex align-items-center justify-content-center"
                                >
                                  <i class="bi bi-file-earmark-text"></i>
                                </div>
                                <div class="ps-3">
                                  <h6>
                                    @{
                                      var act = from act_ in Model.Activities
                                              select new {
                                                act_.Id
                                              };
                                              
                                    }

                                    @act.Count()

                                  </h6>
                                  <span class="text-success small pt-1 fw-bold">
                                    @{
                                      var completed_act = Model.Activities.Where(act => act.ActivityProgress == 4).ToList();
                                      double getPerc_act = 0;
                                      if(act.Count() > 0)
                                      {
                                        getPerc_act = ((double)completed_act.Count / act.Count()) *100;
                                      }
                                    }
                                    @getPerc_act.ToString("F2")%
                                  </span>
                                  <span class="text-muted small pt-2 ps-1">Completed</span>
                                </div>
                              </div>
                            </div>
                          </div>
                        </div>
                        @*End Activities Card *@

                        @*Staff Card *@
                        <div class="col-xxl-4 col-md-4">
                          <div class="card info-card customers-card">
                            <div class="filter">
                              <a class="icon" href="#" data-bs-toggle="dropdown"
                                ><i class="bi bi-three-dots"></i></a>
                              <ul
                                class="dropdown-menu dropdown-menu-end dropdown-menu-arrow"
                              >
                                <li class="dropdown-header text-start">
                                  <h6>Filter</h6>
                                </li>

                                <li><a class="dropdown-item" href="#">Today</a></li>
                                <li><a class="dropdown-item" href="#">This Month</a></li>
                                <li><a class="dropdown-item" href="#">This Year</a></li>
                              </ul>
                            </div>

                            <div class="card-body">
                              <h5 class="card-title">
                                Active Personnel <span>| All</span>
                              </h5>

                              <div class="d-flex align-items-center">
                                <div
                                  class="card-icon rounded-circle d-flex align-items-center justify-content-center"
                                >
                                  <i class="bi bi-people"></i>
                                </div>
                                <div class="ps-3">
                                  <h6>
                                    @{
                                      var acc = from acc_ in Model.Accounts
                                              select new {
                                                acc_.AccountID
                                              };

                                       var projects_ = from acc_ in Model.Projects
                                              select new {
                                                acc_.AccountID
                                              };
                                    }
                                    @acc.Count()
                                  </h6>
                                  <span class="text-danger small pt-1 fw-bold">
                                    @{
                                        var countActive = new List<int>();
                                                                        
                                        foreach(var i in projects_)
                                        {
                                          if(!countActive.Contains(i.AccountID))
                                          {
                                            countActive.Add(i.AccountID);
                                          }
                                        }

                                        double getActiv_staff = 0;
                                        if(acc.Count() > 0)
                                        {
                                          getActiv_staff = ((double)countActive.Count / acc.Count()) *100;
                                        }
                                      }
                                      @getActiv_staff.ToString("F2")%
                                      
                                  </span>
                                  <span class="text-muted small pt-2 ps-1">Active Staff</span>
                                </div>
                              </div>
                            </div>
                          </div>
                        </div>
                        @*End Staff Card *@

                                                                      

                      </div>
                    </div>
                    @*End Left side columns *@
                 

                    @* Full Project Table *@
                    @*Projects & Activities *@
                    <div class="col-12" >
                      <div class="card">
                        
                        <div class="filter">
                          <a class="icon" href="#" data-bs-toggle="dropdown"
                            ><i class="bi bi-three-dots"></i></a>
                          <ul
                            class="dropdown-menu dropdown-menu-end dropdown-menu-arrow"
                          >
                            <li class="dropdown-header text-start">
                              <h6>Filter</h6>
                            </li>

                            <li><a class="dropdown-item" href="#">Today</a></li>
                            <li><a class="dropdown-item" href="#">This Month</a></li>
                            <li><a class="dropdown-item" href="#">This Year</a></li>
                          </ul>
                        </div>

                        <div class="card-body" style="margin:0;padding:0;">
                          <h5 class="card-title p-3 m-0">
                            Projects & Activities <span>| All</span>                           
                          </h5>
                          
                          @using (Html.BeginForm())
                          {
                            <div class="d-flex flex-row row justify-content-between align-content-center m-1 p-1">
                            
                                  <div class="col-sm-4 row border-secondary mx-right">
                                      @Html.TextBox("searchString")  
                                      <button value="Search" class="col-auto btn btn-md btn-outline-primary">
                                          <i class="bi bi-search"></i>
                                      </button>
                                  </div>

                                  <div class="col-sm-8 row border-secondary mx-right gap-1" >

                                      @if(!string.IsNullOrEmpty(Context.Request.Query["sortOrder"] ))
                                      {
                                        <label class="col-sm col-form-label rounded-2 text-center" style="border-bottom:1px solid green;font-size:11px;">
                                          Sorted by: <span style="color:green">@Context.Request.Query["sortOrder"] </span> </label>
                                      }
                                      else
                                      {                                        
                                          <label class="col-sm col-form-label rounded-2 text-center" style="border-bottom:1px solid #ffc107">
                                          Sort Projects by: </label>
                                      }

                                        @{
                                          var StaffFilter_Sort = Context.Request.Query["Staff"];
                                          var StatusFilter_Sort = Context.Request.Query["Status"];
                                        }
                                                                          
                                      <select class="col-sm form-select-sm border-warning" id="sortOrder"> 

                                         <option value="" selected>-- Project Name --</option> 

                                          @{
                                            var NameSortOrder = Context.Request.Query["sortOrder"];                                            
                                            var url_sortName = "";

                                            if(!string.IsNullOrEmpty(StaffFilter_Sort) && !string.IsNullOrEmpty(StatusFilter_Sort))
                                            {
                                                url_sortName = Url.Action("Index", new {Staff = StaffFilter_Sort, Status = StatusFilter_Sort, sortOrder = ViewData["NameSortParm"]});
                                            }
                                            else
                                            if(!string.IsNullOrEmpty(StaffFilter_Sort))
                                            {
                                                url_sortName  = Url.Action("Index", new {Staff = StaffFilter_Sort, sortOrder = ViewData["NameSortParm"]});
                                            }
                                            else
                                            if(!string.IsNullOrEmpty(StatusFilter_Sort))
                                            {
                                                url_sortName  = Url.Action("Index", new {Status = StatusFilter_Sort, sortOrder = ViewData["NameSortParm"]});
                                            }  
                                            else
                                            {
                                                url_sortName  = Url.Action("Index", new {sortOrder = ViewData["NameSortParm"]});
                                            }                                          
                                                  
                                            @: <option value="@url_sortName" >@ViewData["NameSortParm"]</option>  
                                          
                                          }    

                                          <option value="/Home/Index" >Clear Sort</option>                                
                                          
                                      </select>                           
                                                                                                                                                                          
                                      <select class="col-sm form-select-sm border-warning" id="sortDate">                                                         

                                            <option value="" selected>-- Project Date --</option>                         

                                          @{  
                                              var DateSortOrder = Context.Request.Query["sortOrder"];
                                              var url_sortDate = "";
                                            
                                              if(!string.IsNullOrEmpty(StaffFilter_Sort) && !string.IsNullOrEmpty(StatusFilter_Sort))
                                              {
                                                  url_sortDate = Url.Action("Index", new {Staff = StaffFilter_Sort, Status = StatusFilter_Sort, sortOrder = ViewData["DateSortParm"]});
                                              }
                                              else
                                              if(!string.IsNullOrEmpty(StaffFilter_Sort))
                                              {
                                                  url_sortDate  = Url.Action("Index", new {Staff = StaffFilter_Sort, sortOrder = ViewData["DateSortParm"]});
                                              }
                                              else
                                              if(!string.IsNullOrEmpty(StatusFilter_Sort))
                                              {
                                                  url_sortDate  = Url.Action("Index", new {Status = StatusFilter_Sort, sortOrder = ViewData["DateSortParm"]});
                                              }
                                              else
                                              {
                                                  url_sortDate  = Url.Action("Index", new {sortOrder = ViewData["DateSortParm"]});
                                              }
                                              
