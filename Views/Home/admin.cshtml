                                          var countActivity = 0;
                                          foreach(var act_ in Model.Activities
                                                  .Where(a => a.ProjectID == proj.Id)
                                                  .OrderBy(a => a.ActivityStartDate))
                                          {

                                              countActivity++;
                                              @* ACTIVITIES *@
                                              <tr>

                                                @* ActivityName *@
                                                <td class="align-middle">
                                                    <span>
                                                      <span class="fw-bold">@countActivity.</span> @act_.ActivityName
                                                    </span>
                                                </td>

                                                @* ActivityComments *@
