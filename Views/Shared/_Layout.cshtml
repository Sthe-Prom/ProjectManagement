    <!-- Sweet Alert -->
    <link rel="stylesheet" type="text/css" href="https://common.olemiss.edu/_js/sweet-alert/sweet-alert.css">

     <!-- Tailwind CSS (for general aesthetics as per instructions) -->
    @* <script src="https://cdn.tailwindcss.com"></script> *@
    <style>
        body {
            font-family: "Inter", sans-serif; /* Recommended font */           
        }
      
        /* Custom styling for the alert box (instead of alert()) */
        .custom-alert {
            display: none;
            position: fixed;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            background-color: #4CAF50;
            color: white;
            padding: 15px;
            border-radius: 8px;
            box-shadow: 0 4px 8px rgba(0, 0, 0, 0.2);
            z-index: 1000;
            text-align: center;
        }
        .custom-alert.error {
            background-color: #f44336;
        }
        
        .btn-ufs-red{
            background-color: #A71930;
            color: "#fff !important";
        }

    </style>
 
</head>
<body>
    
    @if(signInManager.IsSignedIn(User))                                               
    {               
        <header>
            <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
                <div class="container-fluid">
                    <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index"  style="color: #0F204B; margin: 10px;"><strong>MIR Projects</strong></a>
                    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                            aria-expanded="false" aria-label="Toggle navigation">
                        <span class="navbar-toggler-icon"></span>
                    </button>
                    <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">

                        @if(await userManager.IsInRoleAsync(user_id,"Admin"))
                        {
                            <ul class="navbar-nav flex-grow-1">
                                <li class="nav-item">
                                    <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Index">Home</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Privacy">Users</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Privacy">Roles</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Privacy">Projects</a>
                                </li>
                            </ul>
                        }
                        else
                        {
                            <ul class="navbar-nav flex-grow-1">
                                <li class="nav-item">
                                    <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Index">Project</a>
                                </li>                                    
                                <li class="nav-item">
                                    <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Index">Activities</a>
                                </li>
                            </ul>
                        }
                    </div>

                        @* @{
                            var user_acc = Model.Accounts.Where(c => c.Id == userId).FirstOrDefault();
                        } *@
                    
                        @if(Model.Accounts.Where(c => c.Id == userId).FirstOrDefault() != null) 
                        {                                        
                            var acc = Model.Accounts.Where(c => c.Id == userId).FirstOrDefault();

                            @* Example single danger button *@
                            @* <div class=""> *@
                                <ul class="nav">
                                    
                                        <span class="nav-item">
                                            <a asp-action="Index" asp-controller="Account" class="nav-link text-dark" asp-route-AccountID="@acc.AccountID">My Account</a>
                                        </span>                                       
                                    
                                        <span class="nav-link" style="padding-left:0;padding-right:0;color:#A71930;">  &vert; </span>
                                                                      
                                        <span class="nav-link text-dark">
                                            @* <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="#A71930" class="bi bi-person" viewBox="0 0 16 16">
                                                <path d="M8 8a3 3 0 1 0 0-6 3 3 0 0 0 0 6m2-3a2 2 0 1 1-4 0 2 2 0 0 1 4 0m4 8c0 1-1 1-1 1H3s-1 0-1-1 1-4 6-4 6 3 6 4m-1-.004c-.001-.246-.154-.986-.832-1.664C11.516 10.68 10.289 10 8 10s-3.516.68-4.168 1.332c-.678.678-.83 1.418-.832 1.664z"/>
                                            </svg>                                         *@
                                            @acc.FirstName @acc.LastName 
                                        </span>                                        
                                   
                                        <span class="nav-link" style="padding-left:0;padding-right:0;color:#A71930;">  &vert; </span>
                                                                    
                                        <a class="nav-link text-dark" asp-action="Logout" asp-controller="UserAccount">                                                
                                            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="20px" height="20px" fill="#A71930"><path d="M5 22C4.44772 22 4 21.5523 4 21V3C4 2.44772 4.44772 2 5 2H19C19.5523 2 20 2.44772 20 3V6H18V4H6V20H18V18H20V21C20 21.5523 19.5523 22 19 22H5ZM18 16V13H11V11H18V8L23 12L18 16Z"></path></svg> 
                                        </a>
                                 
                                </ul>
                               
                            @* </div>                                                                   *@
                                
                        }
                        else
                        {
                            @* <div class="navbar-collapse collapse d-sm-inline-flex justify-content-right" style="float:right;"> *@
                                <ul class="nav">
                                    
                                    <span class="nav-item">
                                        <a class="nav-link text-dark" href="~/Account/Profile">Manage Account</a>
                                    </span>
                                   
                                    <span class="nav-link text-dark" style="padding-left:0;padding-right:0;color:#A71930;">  &vert; </span>

                                    <span  class="nav-link text-dark" style="color:#A71930;">@user_id.UserName</span>     

                                    <span class="nav-link text-dark" style="padding-left:0;padding-right:0;color:#A71930;">  &vert; </span>

                                    <a class="nav-link text-dark" asp-action="Logout" asp-controller="UserAccount">                                                
                                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="20px" height="20px" fill="#A71930"><path d="M5 22C4.44772 22 4 21.5523 4 21V3C4 2.44772 4.44772 2 5 2H19C19.5523 2 20 2.44772 20 3V6H18V4H6V20H18V18H20V21C20 21.5523 19.5523 22 19 22H5ZM18 16V13H11V11H18V8L23 12L18 16Z"></path></svg> 
                                    </a>
                                    
                                </ul>
                            @* </div> *@
                                
                        }
                    

                </div>
            </nav>
        </header>          
        
    }
                
    <div class="container-fluid">
        <main role="main" style="min-height:500px;margin: 10px;" class="pb-3">
                              
            @RenderBody()
              
        </main>
    </div>

    <!-- Custom Alert Box HTML -->
    <div id="customAlert" class="custom-alert">
        <p id="alertMessage"></p>
    </div>
    
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="https://code.jquery.com/jquery-3.7.1.js"></script>
    @* <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script> *@
    @* <script src="https://cdn.jsdelivr.net/npm/bootstrap@4.6.2/dist/js/bootstrap.bundle.min.js"></script> *@
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.6/dist/js/bootstrap.bundle.min.js" integrity="sha384-j1CDi7MgGQ12Z7Qab0qlWQ/Qqz24Gc6BM0thvEMVjHnfYGF0rmFCozFSxQBxwHKO" crossorigin="anonymous"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @* <script src="~/js/table.js" asp-append-version="true"></script> *@

    <script src="https://common.olemiss.edu/_js/sweet-alert/sweet-alert.min.js"></script>  

    @* Data table *@
