@{
    Layout = "_AuthenticationLayout";
    ViewData["Title"] = "Check your email";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-5 col-md-7">
            <div class="card shadow-sm">
                <div class="card-body p-4">
                    <h1 class="h3 mb-3">Check your email</h1>
                    <p>If the email address belongs to an account, check your inbox for reset instructions. If no message arrives, contact support.</p>
                    <a asp-action="Login" class="btn btn-primary">Back to sign in</a>
                </div>
            </div>
        </div>
    </div>
</div>
