@model ForgotPasswordModel
@{
    Layout = "_AuthenticationLayout";
    ViewData["Title"] = "Forgot password";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-5 col-md-7">
            <div class="card shadow-sm">
                <div class="card-body p-4">
                    <h1 class="h3 mb-3">Forgot password?</h1>
                    <p>Enter the email address associated with your account and we will send password reset instructions if an account matches.</p>
                    <div asp-validation-summary="All" class="text-danger mb-3"></div>
                    <form asp-action="ForgotPassword" method="post">
                        <div class="mb-3">
                            <label asp-for="Email" class="form-label">Email address</label>
                            <input asp-for="Email" class="form-control" type="email" autocomplete="email" />
                            <span asp-validation-for="Email" class="text-danger"></span>
                        </div>
                        <button type="submit" class="btn btn-primary">Send reset link</button>
                        <a asp-action="Login" class="btn btn-link">Back to sign in</a>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
